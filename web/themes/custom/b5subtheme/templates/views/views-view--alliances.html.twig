<section class="alliances-search" style="--alliances-primary-color: {{ site_primary_color|default('#ff4949') }};">
  <div class="my-custom-container-2">
    <div class="alliances-search__inner">
      <h1>{{ title|default('Alliances'|t) }}</h1>

      {% if exposed %}
        <div class="alliances-search__form">
          {{ exposed }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="alliances-grid section-container">
  <div class="my-custom-container-2">
    {% if view.result %}
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 g-xl-5">
        {% for row in view.result %}
          {% set alliance = row._entity %}
          {% set file = alliance.field_alliance_logo.entity %}
          {% set description = alliance.field_alliance_description.processed|default(alliance.field_alliance_description.value|default('')) %}
          {% set alliance_url = '/alliances/' ~ alliance.id() %}

          <div class="col">
            <a href="{{ alliance_url }}" class="alliance-card">
              <div class="alliance-card__media">
                {% if file %}
                  <img src="{{ file_url(file.getFileUri()) }}" alt="{{ alliance.title.value }}">
                {% endif %}
              </div>

              <div class="alliance-card__body">
                <h2 class="alliance-card__title">{{ alliance.title.value }}</h2>

                {% if description %}
                  <p class="alliance-card__description">
                    {{ description|striptags }}
                  </p>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="alliances-grid__empty">{{ 'No alliances found.'|t }}</p>
    {% endif %}
  </div>
</section>
