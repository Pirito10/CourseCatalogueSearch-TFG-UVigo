								{% set programme = row.display_programme|default(iec.field_iec_programme.entity ?? null) %}


								<div class="iec-item">
									<a href="{{row.custom_url}}" class="text-decoration-none text-reset" target="_blank">

										<div class="card shadow-none mb-3 border-0 rounded-0 position-relative catalogue-programme-card" style="cursor: pointer;">
											{% if iec.field_iec_avaliable_for_mobility.value %}
												<div class="mobility-badge">
													<img src="/themes/custom/b5subtheme/images/mobility_iec.jpeg" alt="Available for mobility">
												</div>
											{% endif %}

											<div
												class="card-body p-2">

												<h5 class="card-title mb-1 text-start">
													{{ iec.label }}
												</h5>

												{% if programme %}
													<div class="mb-2">
														<span class="fst-italic">
															{{ programme.label }}
														</span>
													</div>
												{% endif %}
												<!-- Línea intermedia: nivel, créditos y área -->
												<div class="programme-meta d-flex align-items-center mb-2">


													{% if iec.field_iec_credits.value %}
														<!--<span class="mx-2">·</span>-->
														<span class="fst-italic">{{ iec.field_iec_credits.value }}
															ECTS
														</span>
														<span class="mx-2">·</span>
													{% endif %}

													{% if iec.field_iec_term.value %}
														<!--<span class="mx-2">·</span>-->
														<span class="fst-italic">Term:
															{{ iec.field_iec_term.value }}
														</span>
													{% endif %}

													{% set lang_labels = row.display_instruction_languages|default([]) %}
													{% if lang_labels is empty %}
														{% set langs = iec.field_iec_language_of_instructio ?? [] %}
														{% if langs is not empty %}
															{% set lang_labels = [] %}
															{% for item in langs %}
																{% set lang_label = item.entity.label ?? item.value ?? '' %}
																{% if lang_label %}
																	{% set lang_labels = lang_labels|merge([lang_label]) %}
																{% endif %}
															{% endfor %}
														{% endif %}
													{% endif %}
													{% if lang_labels is not empty %}
														<span class="mx-2">·</span>
														<span class="fst-italic">
															{{ lang_labels|join(', ') }}
														</span>
													{% endif %}
												</div>


												{# (Opcional) aquí puedes añadir más “meta” de la IEC si quieres:
																																						                       - tipo, área, país, institución, etc.
																																						                       Solo dime qué campos tienes. #}

											</div>
										</div>

									</a>
								</div>

							{% endfor %}
						{% else %}
							<p class="empty">{{ empty }}</p>
						{% endif %}

						{{ pager }}
