			</div>
		</div>


		<div class="section-container bg-light">
			<div class="my-custom-container-2">
				<div class="row institution-new-catalogue-results">
					<div class="col-lg-2 institution-new-catalogue-sort">
					{#
						<h3 class="subsection-title p-0 pb-2 m-0">
							<i class="fas fa-sort-amount-down me-2"></i>
							{{ 'Sort'|t|upper }}
						</h3>

						<div
							class="group-search-sort-buttons w-100">
							
							<button class="btn btn-dark btn-sm btn-whithout-border-radius js-sort disabled" data-sort-by="title" data-sort-order="ASC">
								A - Z
