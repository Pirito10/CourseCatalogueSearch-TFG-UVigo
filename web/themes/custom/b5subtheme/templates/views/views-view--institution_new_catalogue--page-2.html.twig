<script>
	(function () { // Quita trailing slash salvo que sea "/"
function replaceLastPathSegment(pathname, newSegment) {
const hasTrailingSlash = pathname.length > 1 && pathname.endsWith('/');
const clean = hasTrailingSlash ? pathname.slice(0, -1) : pathname;

const parts = clean.split('/').filter(Boolean); // sin vacíos
if (parts.length === 0) 
return '/' + newSegment;



parts[parts.length - 1] = newSegment;
return '/' + parts.join('/') + (hasTrailingSlash ? '/' : '');
}

document.querySelectorAll('.newcatalogue-btn[data-target-segment]').forEach((btn) => {
btn.addEventListener('click', (e) => {
e.preventDefault();

const target = btn.getAttribute('data-target-segment');
if (! target) 
return;



const {pathname, search, hash} = window.location;
const nextPath = replaceLastPathSegment(pathname, target);

// Mantiene ?query y #hash
window.location.href = nextPath + search + hash;
});
});
})();
</script>

