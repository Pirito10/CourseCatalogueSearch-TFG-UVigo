<div class="degree-sidebar-wrapper ">

  <div class="degree-sidebar bg-light">
    <div class="row g-3 mx-0">

      {# -------------------------
         Columna 1: General Data
         ------------------------- #}
      <div class="col-12 col-md-6 col-xl-12">
        <h3 class="subsection-title m-0 mb-3">
          {{ 'General Data'|t }}
        </h3>

        {% if fields.field_start_date is defined and fields.field_start_date.content|render|striptags|trim %}
          <div class="degree-info-item mb-2">
            <strong>{{ 'Start Date'|t }}:</strong>
            {{ fields.field_start_date.content }}
          </div>
        {% endif %}

        {% if fields.field_end_date is defined and fields.field_end_date.content|render|striptags|trim %}
          <div class="degree-info-item mb-2">
            <strong>{{ 'End Date'|t }}:</strong>
            {{ fields.field_end_date.content }}
          </div>
        {% endif %}

        {% if fields.field_iec_instance_type is defined and fields.field_iec_instance_type.content|render|striptags|trim %}
          <div class="degree-info-item mb-2">
            <strong>{{ 'Category'|t }}:</strong>
            {{ fields.field_iec_instance_type.content }}
          </div>
        {% endif %}

        {% if fields.field_number_of_credits is defined and fields.field_number_of_credits.content|render|striptags|trim %}
          <div class="degree-info-item mb-2">
            <strong>{{ 'Credits'|t }}:</strong>
            {{ fields.field_number_of_credits.content }}
          </div>
        {% endif %}

        {% if fields.field_engagement_hours is defined and fields.field_engagement_hours.content|render|striptags|trim %}
          <div class="degree-info-item mb-2">
            <strong>{{ 'Engagement hours'|t }}:</strong>
            {{ fields.field_engagement_hours.content }}
          </div>
        {% endif %}

        {% if fields.field_iec_instance_language is defined and fields.field_iec_instance_language.content|render|striptags|trim %}
      <div class="degree-info-item mb-2">
        <strong>{{ 'Languages'|t }}:</strong>
        {{ fields.field_iec_instance_language.content }}
      </div>
    {% endif %}

        {% if fields.field_iec_instance_mode_delivery is defined and fields.field_iec_instance_mode_delivery.content|render|striptags|trim %}
          <div class="degree-info-item mb-2">
            <strong>{{ 'Modality'|t }}:</strong>
            {{ fields.field_iec_instance_mode_delivery.content }}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>
