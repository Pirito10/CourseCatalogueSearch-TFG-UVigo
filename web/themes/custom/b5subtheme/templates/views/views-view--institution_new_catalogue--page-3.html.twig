<style>:root
{
	--university_primary_color: {{ catalogue_university_primary_color }};
	--university_text_color: {{ catalogue_university_text_color }};
	--university_emphasis_text_color: {{ catalogue_university_emphasis_text_color }};
}</style>

<div class="negative-margin-search-page">
	<div class="view view-id-{{ view.id }} view-display-id-{{ view.current_display }}
	              js-view-dom-id-{{ view.dom_id }} view-dom-id-{{ view.dom_id }}" data-view-dom-id="{{ view.dom_id }}">

		<div{{ attributes.addClass('catalogue-view', 'catalogue-index-view') }}>
			<div class="catalogue-index-band" style="background: {{ catalogue_university_primary_color }}; color: #fff; padding: 0.75rem 0;">
				<div class="my-custom-container-2">
					<div class="d-flex align-items-center gap-3 flex-wrap">
						<h1 class="p-0 m-0" style="color: #fff; font-weight: 400; font-size: 1.5rem; line-height: 1.1;">
							{% if catalogue_shac_code %}
								<span style="font-weight: 700;">{{ catalogue_shac_code }}</span>
							{% endif %}
							{{ 'catalogue index'|t }}
						</h1>

						{% if catalogue_programmes_search_url %}
							<a href="{{ catalogue_programmes_search_url }}" class="btn btn-whithout-border-radius px-3 py-2" style="border: 2px solid #fff; color: #fff; background: transparent; font-weight: 700; font-size: 1rem; line-height: 1;">
								{{ 'search'|t }}
							</a>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="section-container bg-light">
				<div class="my-custom-container-2">
					<div class="row align-items-center mb-4">
						<div class="col-md-3">
						</div>
						<div class="col-md-6 text-center">
							<h2 class="section-title p-0 m-0" style="font-weight: 400;">{{ 'Full catalogue'|t }}</h2>
						</div>
						<div class="col-md-3"></div>
					</div>

					{% if area_meta|default([])|length > 0 %}
						<div class="accordion catalogue-index-accordion" id="accordionCatalogueIndex">
							{% for area_key, meta in area_meta %}
								{% set B = programmes_by_area[area_key]['B']|default([]) %}
								{% set M = programmes_by_area[area_key]['M']|default([]) %}
								{% set D = programmes_by_area[area_key]['PhD']|default([]) %}
								{% set ordered = B|merge(M)|merge(D) %}
								{% set total = ordered|length %}

								{% if total > 0 %}
									{% set cid = 'catalogue-index-' ~ loop.index ~ '-' ~ area_key|replace({' ':'-', '/':'-'}) %}
									{% set expanded = loop.first %}

									<div class="accordion-item border-0 rounded-0 mb-2">
										<h2 class="accordion-header" id="{{ cid }}-head">
											<button class="accordion-button {{ expanded ? '' : 'collapsed' }} rounded-0" type="button" data-bs-toggle="collapse" data-bs-target="#{{ cid }}-body" aria-expanded="{{ expanded ? 'true' : 'false' }}" aria-controls="{{ cid }}-body">
												{% if meta.icon is defined and meta.icon %}
													<i class="{{ meta.icon }} me-4" style="color: #000;"></i>
												{% endif %}
												<span class="fw-semibold text-uppercase">{{ meta.label|default(area_key) }}</span>
												<span class="ms-auto small fw-bold pe-3">
													B {{ B|length }}
													<span class="mx-2">·</span>
													M {{ M|length }}
													<span class="mx-2">·</span>
													PhD {{ D|length }}
												</span>
											</button>
										</h2>

										<div id="{{ cid }}-body" class="accordion-collapse collapse {{ expanded ? 'show' : '' }}" aria-labelledby="{{ cid }}-head">
											<div class="accordion-body bg-white">
												{% set cols = total > 18 ? 3 : 2 %}
												{% set per_col = (total / cols)|round(0, 'ceil') %}

												<div class="row g-4">
													{% for c in 0..(cols - 1) %}
														{% set slice = ordered|slice(c * per_col, per_col) %}
														{% if slice|length %}
															<div class="col-md-{{ 12 // cols }}">
																<ul class="list-unstyled mb-0">
																	{% for p in slice %}
																		{% set prefix = p.level_code|default('') %}
																		{% if prefix starts with '6' %}
																			{% set prefix = 'B' %}
																		{% elseif prefix starts with '7' %}
																			{% set prefix = 'M' %}
																		{% elseif prefix starts with '8' %}
																			{% set prefix = 'PhD' %}
																		{% endif %}

																		<li class="mb-2">
																			<span class="fw-bold me-1" style="color: {{ prefix == 'B' ? '#111' : catalogue_university_primary_color }};">{{ prefix }}</span>
																			<span>&middot;</span>

																			{% if p.programme_url is defined and p.programme_url %}
																				<a href="{{ p.programme_url }}" class="text-reset text-decoration-none ms-1">{{ p.label }}</a>
																			{% else %}
																				<span class="ms-1">{{ p.label }}</span>
																			{% endif %}

																			{% if p.interuniversity is defined and p.interuniversity %}
																				<em class="ms-2" style="color: {{ catalogue_university_primary_color }};">{{ 'Interuniversity'|t }}</em>
																			{% endif %}

																			{% if p.ects is defined and p.ects %}
																				<span class="text-muted ms-2">{{ p.ects }} ECTS</span>
																			{% endif %}
																		</li>
																	{% endfor %}
																</ul>
															</div>
														{% endif %}
													{% endfor %}
												</div>
											</div>
										</div>
									</div>
								{% endif %}
							{% endfor %}
						</div>

						<div class="text-center mt-5">
							<button class="btn btn-dark btn-whithout-border-radius px-5" type="button" data-catalogue-collapse-all>
								{{ 'Collapse all'|t }}
							</button>
						</div>
					{% else %}
						<p class="empty">{{ empty|default('No programmes found.'|t) }}</p>
					{% endif %}

					{{ pager }}
				</div>
			</div>

			{{ attachment_after }}
		</div>
	</div>
</div>

<script>
	(function () {
		document.querySelectorAll('[data-catalogue-collapse-all]').forEach(function (button) {
			button.addEventListener('click', function () {
				document.querySelectorAll('.catalogue-index-accordion .accordion-collapse.show').forEach(function (element) {
					if (window.bootstrap && window.bootstrap.Collapse) {
						window.bootstrap.Collapse.getOrCreateInstance(element).hide();
					}
					else {
						element.classList.remove('show');
					}
				});
			});
		});
	})();
</script>
