  if ($institution_id && is_numeric($institution_id)) {
    $institution = Node::load((int) $institution_id);
  }
  elseif ($institution_id) {
    $alias_manager = \Drupal::service('path_alias.manager');
    foreach ([$current_language, 'en'] as $alias_language) {
      $internal_path = $alias_manager->getPathByAlias('/' . trim($institution_id, '/'), $alias_language);
      if (preg_match('/^\/node\/(\d+)$/', $internal_path, $matches)) {
        $institution = Node::load((int) $matches[1]);
        break;
      }
    }
  }

  if ($institution) {
    $institution_for_colors = $institution;

    if ($institution->hasTranslation($current_language)) {
      $institution = $institution->getTranslation($current_language);
    }

    $variables['catalogue_institution'] = $institution;
    $variables['catalogue_university_primary_color'] =
      ($institution_for_colors->hasField('field_primary_color') && !$institution_for_colors->get('field_primary_color')->isEmpty() && isset($institution_for_colors->get('field_primary_color')->first()->color))
