    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();
}






function getEntityFromAlias($alias, $langcode = NULL)
{

  $alias_manager = \Drupal::service('path_alias.manager');

  $internal_path = $alias_manager->getPathByAlias('/' . $alias, $langcode);

  if (preg_match('/^\/node\/(\d+)$/', $internal_path, $matches)) {
    $nid = (int) $matches[1];

   
    $node = Node::load($nid);

   
    if ($langcode && $node->hasTranslation($langcode)) {
      return $node->getTranslation($langcode);
    }

    return $node;
  }

  return NULL;
}

/**
 * Returns an entity translated to the current language, falling back to English.
 */
function b5subtheme_entity_for_language_with_fallback(?EntityInterface $entity, string $langcode): ?EntityInterface
{
  if (!$entity) {
    return NULL;
  }

  if ($entity->hasTranslation($langcode)) {
    return $entity->getTranslation($langcode);
  }

  if ($entity->hasTranslation('en')) {
    return $entity->getTranslation('en');
  }

  return $entity;
}

/**
 * Returns the language that should be used when linking to an entity.
 */
function b5subtheme_entity_language_for_url(?EntityInterface $entity, string $langcode): string
{
  if (!$entity) {
    return 'en';
  }

  if ($entity->hasTranslation($langcode)) {
    return $langcode;
  }

  if ($entity->hasTranslation('en')) {
    return 'en';
  }

  return $entity->language()->getId();
}

/**
 * Returns translated labels for referenced entities in a field.
 */
function b5subtheme_referenced_entity_labels_for_language(EntityInterface $entity, string $field_name, string $langcode): array
{
  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return [];
  }

  $labels = [];
  foreach ($entity->get($field_name) as $item) {
    $referenced_entity = $item->entity ?? NULL;
    if ($referenced_entity instanceof EntityInterface) {
      $referenced_entity = b5subtheme_entity_for_language_with_fallback($referenced_entity, $langcode);
      $labels[] = $referenced_entity->label();
    }
    elseif (!empty($item->value)) {
      $labels[] = $item->value;
    }
  }

  return array_filter($labels);
}

/**
 * Returns ISCED-F labels in the requested language, falling back to English.
 */
function b5subtheme_isced_labels_for_language(string $langcode): array
{
  $isced = new IscedFieldsOfStudy();
  $labels = [];

  foreach ($isced->getLabeledList() as $code => $label) {
    // ISCED labels are provided by the isced_field translation catalogue.
    // phpcs:ignore Drupal.Semantics.FunctionT.NotLiteralString
    $labels[$code] = (string) t($label, [], ['langcode' => $langcode]);
  }

  return $labels;
}

/**
 * Builds the declared curriculum structure for a programme node.
 */
function b5subtheme_programme_curriculum_structure(?NodeInterface $programme): array
{
  $terms_per_year = 2;
  $total_terms = 8;

  if ($programme instanceof NodeInterface) {
    if ($programme->hasField('field_number_of_terms') && !$programme->get('field_number_of_terms')->isEmpty()) {
      $terms_per_year = (int) $programme->get('field_number_of_terms')->value;
    }

    if ($programme->hasField('field_length_of_programme') && !$programme->get('field_length_of_programme')->isEmpty()) {
      $total_terms = (int) $programme->get('field_length_of_programme')->value;
    }
  }

  $terms_per_year = max(1, $terms_per_year);
  $total_terms = max(1, $total_terms);
  $number_of_years = max(1, (int) ceil($total_terms / $terms_per_year));

  $years = [];
  for ($year = 1; $year <= $number_of_years; $year++) {
    $years[(string) $year] = [
      'id' => (string) $year,
      'label' => t('Year @number', ['@number' => $year]),
    ];
  }

  $terms = [];
  $term_short_labels = [];
  for ($term = 1; $term <= $terms_per_year; $term++) {
    $terms[$term] = [
      'id' => $term,
      'label' => t('Term @number', ['@number' => $term]),
    ];
    $term_short_labels[(string) $term] = (string) $term;
  }

  return [
    'terms_per_year' => $terms_per_year,
    'total_terms' => $total_terms,
    'number_of_years' => $number_of_years,
    'years' => $years,
    'terms' => $terms,
    'term_short_labels' => $term_short_labels,
  ];
}








/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function b5subtheme_preprocess_page(&$variables)
{



  // Your custom preprocess code for pages.
  $variables['#attached']['library'][] = 'b5subtheme/course_buttons';
  $branding = \Drupal::service('settings')->get('site_branding', []);
  $variables['site_primary_color'] = $branding['primary_color'] ?? '#ff4949';

  $path = \Drupal::theme()->getActiveTheme()->getPath() . '/translations/translations.yml';


  // Cargar el contenido del archivo YAML.
  if (file_exists($path)) {
    $translations = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($path));

    // Verifica si las traducciones se están cargando correctamente.
    //\Drupal::logger('b5subtheme')->notice('Translations loaded: <pre>@translations</pre>', ['@translations' => print_r($translations, TRUE)]);

    // Pasar las traducciones al contexto de Twig.
    $variables['translations'] = $translations;
  } else {
    //\Drupal::logger('b5subtheme')->error('Translations file not found at path: @path', ['@path' => $path]);
  }

}

