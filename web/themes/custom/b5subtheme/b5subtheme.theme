  if ($variables['view']->id() == 'campus_information') {
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $area_meta_filtered = [];
    $generic_area_key = 'generic';
    $isced_labels = b5subtheme_isced_labels_for_language($langcode);
    $programmes_by_area = [];
    $area_meta = [];

    $seen = []; // dedupe OU:PROG

    // Recorre resultados de la vista.

    foreach ($variables['view']->result as $row) {
      // Coge entidades vía relaciones de la vista (ajusta los índices si difieren en tu vista).
      $ou = $row->_relationship_entities['reverse__node__field_ou_campus'] ?? NULL;
      $programme = $row->_relationship_entities['reverse__node__field_programme_ou'] ?? NULL;

      if (!$ou || !$programme) {
        continue;
      }

      // Deduplicar por combinación OU+Programme.
      $key = $ou->id() . ':' . $programme->id();
      if (isset($seen[$key])) {
        continue;
      }
      $seen[$key] = TRUE;

      // Traducción al idioma actual si existe.
      if ($ou->hasTranslation($langcode)) {
        $ou = $ou->getTranslation($langcode);
      }
      if ($programme->hasTranslation($langcode)) {
        $programme = $programme->getTranslation($langcode);
      }

      // Nivel -> B / M / PhD.
      $lvl_raw = strtolower($programme->get('field_eqf_level')->value ?? '');
      //dump($programme->title->value);
      //dump($lvl_raw);
      if (str_starts_with($lvl_raw, '6')) {
        $level = 'B';
      } elseif (str_starts_with($lvl_raw, '7')) {
        $level = 'M';
      } elseif (str_starts_with($lvl_raw, '8')) {
        $level = 'PhD';
      } else {
        continue;
      }

      $programme_area_keys = [];
      if ($programme->hasField('field_isced_f') && !$programme->get('field_isced_f')->isEmpty()) {
        foreach ($programme->get('field_isced_f') as $item) {
          $broad_key = $item->broad ?? '';
          if ($broad_key !== '') {
            $programme_area_keys[$broad_key] = $broad_key;
          }
        }
      }

      if ($programme_area_keys === []) {
        $programme_area_keys[$generic_area_key] = $generic_area_key;
      }

      $lang_for_url = $programme->hasTranslation($langcode) ? $langcode : 'en';
      $language = \Drupal::languageManager()->getLanguage($lang_for_url);


      // Canonical en ese idioma (si hay alias lo devuelve; si no, /<lang>/node/<nid>)
      $canonical = Url::fromRoute('entity.node.canonical', ['node' => $programme->id()], ['language' => $language])->toString();
      // /es/universidad-x/programa-y   ó   /es/node/123

      $parts = array_values(array_filter(explode('/', trim($canonical, '/'))));
      // p.ej. ['es','universidad-x','programa-y']  ó  ['es','node','123']

      $programme_url = NULL;
      if (count($parts) >= 3) {
        $last = $parts[count($parts) - 1];     // 'programa-y'  ó '123'
        $prev = $parts[count($parts) - 2];     // 'universidad-x' ó 'node'

        // Si no hay alias (prev == 'node'), no podemos inferir el alias de institución.
        // Usamos un placeholder 'x' que tu hook puede ignorar/gestionar.
        // Si hay alias, usamos institución + programa directamente.
        $institution_alias = ($prev === 'node') ? 'x' : $prev;
        $programme_alias = $last;

        $programme_url = '/' . $lang_for_url . '/catalogue/' . $institution_alias . '/' . $programme_alias;
        //dump($programme_url);
      }
      foreach ($programme_area_keys as $area_key) {
        if (!isset($programmes_by_area[$area_key])) {
          $programmes_by_area[$area_key] = ['B' => [], 'M' => [], 'PhD' => []];
        }

        if (!isset($area_meta[$area_key])) {
          $area_meta[$area_key] = [
            'label' => $area_key === $generic_area_key
              ? (string) t('Other', [], ['langcode' => $langcode])
              : ($isced_labels[$area_key] ?? $area_key),
            'icon' => 'fas fa-folder',
          ];
        }

        $programmes_by_area[$area_key][$level][] = [
          'id' => $programme->id(),
          'label' => $programme->label(),
          'level_code' => $programme->get('field_eqf_level')->value,
          'programme_url' => $programme_url,
        ];
      }
    }

    // Ordena alfabéticamente por label en cada bucket.
    foreach ($programmes_by_area as $area => $levels) {
      foreach (['B', 'M', 'PhD'] as $lev) {
        usort($programmes_by_area[$area][$lev], static function ($a, $b) {
          return strcasecmp($a['label'], $b['label']);
        });
      }
    }


    // Cuando termines de rellenar, filtra las vacías:
    foreach ($programmes_by_area as $area_key => $levels) {
      $total = count($levels['B']) + count($levels['M']) + count($levels['PhD']);
      if ($total > 0) {
        $area_meta_filtered[$area_key] = $area_meta[$area_key];
      }
    }

    if (isset($area_meta_filtered[$generic_area_key])) {
      $generic_area = $area_meta_filtered[$generic_area_key];
      unset($area_meta_filtered[$generic_area_key]);
      ksort($area_meta_filtered, SORT_NATURAL);
      $area_meta_filtered[$generic_area_key] = $generic_area;
    } else {
      ksort($area_meta_filtered, SORT_NATURAL);
    }

    $variables['area_meta'] = $area_meta_filtered;
    $variables['programmes_by_area'] = $programmes_by_area;



    $full_country_list = \Drupal::service('address.country_repository')->getList($langcode);
    $country_code = $variables['view']->result[0]->_relationship_entities['field_campus_institution']->get('field_institution_country')->value;
    $variables['institution_country_name'] = t($full_country_list[$country_code], [], ['langcode' => $langcode]);




    //dump($area_meta_filtered);
    //dump($programmes_by_area);


  }











  if ($variables['view']->id() == 'organizational_unit_information') {
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $area_meta_filtered = [];
    $generic_area_key = 'generic';
    $isced_labels = b5subtheme_isced_labels_for_language($langcode);
    $programmes_by_area = [];
    $area_meta = [];

    $seen = [];

    foreach ($variables['view']->result as $row) {
      $ou = $row->_entity; // la OU principal de la vista
      $programme = $row->_relationship_entities['reverse__node__field_programme_ou'] ?? NULL;

      if (!$ou || !$programme) {
        continue;
      }

      $key = $ou->id() . ':' . $programme->id();
      if (isset($seen[$key])) {
        continue;
      }
      $seen[$key] = TRUE;

      if ($ou->hasTranslation($langcode)) {
        $ou = $ou->getTranslation($langcode);
      }
      if ($programme->hasTranslation($langcode)) {
        $programme = $programme->getTranslation($langcode);
      }

      // Nivel
      $lvl_raw = strtolower($programme->get('field_eqf_level')->value ?? '');
      if (str_starts_with($lvl_raw, '6')) {
        $level = 'B';
      } elseif (str_starts_with($lvl_raw, '7')) {
        $level = 'M';
      } elseif (str_starts_with($lvl_raw, '8')) {
        $level = 'PhD';
      } else {
        continue;
      }

      $programme_area_keys = [];
      if ($programme->hasField('field_isced_f') && !$programme->get('field_isced_f')->isEmpty()) {
        foreach ($programme->get('field_isced_f') as $item) {
          $broad_key = $item->broad ?? '';
          if ($broad_key !== '') {
            $programme_area_keys[$broad_key] = $broad_key;
          }
        }
      }

      if ($programme_area_keys === []) {
        $programme_area_keys[$generic_area_key] = $generic_area_key;
      }

      // URL (igual que en campus_information, pero institución desde OU)
      $lang_for_url = $programme->hasTranslation($langcode) ? $langcode : 'en';
      $language = \Drupal::languageManager()->getLanguage($lang_for_url);

      $prog_canonical = Url::fromRoute('entity.node.canonical', ['node' => $programme->id()], ['language' => $language])->toString();
      $prog_parts = array_values(array_filter(explode('/', trim($prog_canonical, '/'))));
      $programme_alias = end($prog_parts);

      $institution_alias = 'x';
      $inst = NULL;
      if ($programme->hasField('field_programme_institution') && !$programme->get('field_programme_institution')->isEmpty()) {
        $inst = $programme->get('field_programme_institution')->entity;
      } elseif ($ou->hasField('field_ou_institution') && !$ou->get('field_ou_institution')->isEmpty()) {
        $inst = $ou->get('field_ou_institution')->entity;
      } elseif ($ou->hasField('field_ou_campus') && !$ou->get('field_ou_campus')->isEmpty()) {
        $campus = $ou->get('field_ou_campus')->entity;
        if ($campus && $campus->hasField('field_campus_institution') && !$campus->get('field_campus_institution')->isEmpty()) {
          $inst = $campus->get('field_campus_institution')->entity;
        }
      }

      if ($inst) {
        if ($inst->hasTranslation($lang_for_url)) {
          $inst = $inst->getTranslation($lang_for_url);
        }
        $inst_canonical = Url::fromRoute('entity.node.canonical', ['node' => $inst->id()], ['language' => $language])->toString();
        $inst_parts = array_values(array_filter(explode('/', trim($inst_canonical, '/'))));
        if (count($inst_parts) >= 2 && $inst_parts[count($inst_parts) - 2] !== 'node') {
          $institution_alias = end($inst_parts);
        }
      }

      $programme_url = '/' . $lang_for_url . '/catalogue/' . $institution_alias . '/' . $programme_alias;

      foreach ($programme_area_keys as $area_key) {
        if (!isset($programmes_by_area[$area_key])) {
          $programmes_by_area[$area_key] = ['B' => [], 'M' => [], 'PhD' => []];
        }

        if (!isset($area_meta[$area_key])) {
          $area_meta[$area_key] = [
            'label' => $area_key === $generic_area_key
              ? (string) t('Other', [], ['langcode' => $langcode])
              : ($isced_labels[$area_key] ?? $area_key),
            'icon' => 'fas fa-folder',
          ];
        }

        $programmes_by_area[$area_key][$level][] = [
          'id' => $programme->id(),
          'label' => $programme->label(),
          'level_code' => $programme->get('field_eqf_level')->value,
          'programme_url' => $programme_url,
        ];
      }
    }

    foreach ($programmes_by_area as $area => $levels) {
      foreach (['B', 'M', 'PhD'] as $lev) {
        usort($programmes_by_area[$area][$lev], static function ($a, $b) {
          return strcasecmp($a['label'], $b['label']);
        });
      }
    }

    // Cuando termines de rellenar, filtra las vacías:
    foreach ($programmes_by_area as $area_key => $levels) {
      $total = count($levels['B']) + count($levels['M']) + count($levels['PhD']);
      if ($total > 0) {
        $area_meta_filtered[$area_key] = $area_meta[$area_key];
      }
    }

    if (isset($area_meta_filtered[$generic_area_key])) {
      $generic_area = $area_meta_filtered[$generic_area_key];
      unset($area_meta_filtered[$generic_area_key]);
      ksort($area_meta_filtered, SORT_NATURAL);
      $area_meta_filtered[$generic_area_key] = $generic_area;
    } else {
      ksort($area_meta_filtered, SORT_NATURAL);
    }

    $variables['area_meta'] = $area_meta_filtered;
    $variables['programmes_by_area'] = $programmes_by_area;


    //dump($programmes_by_area);
  }



  if ($variables['view']->id() === 'search_programme' || $variables['view']->id() === 'searcher') {
    $branding = \Drupal::service('settings')->get('site_branding', []);
    $variables['search_site_primary_color'] = $branding['primary_color'] ?? '#ff4949';

    // Idioma de contenido actual.
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

    // Países traducidos (Address).
    $variables['country_list'] = \Drupal::service('address.country_repository')->getList($langcode);

    // Etiquetas "bonitas" para programme_area por idioma (ajusta si quieres cargar de config).
    $map = [
      'es' => [
        'arts_and_humanities' => 'Artes y Humanidades',
        'sciences' => 'Ciencias',
        'health_sciences' => 'Ciencias de la Salud',
        'social_and_legal_sciences' => 'Ciencias Sociales y Jurídicas',
        'engineering_and_architecture' => 'Ingeniería y Arquitectura',
      ],
      'en' => [
        'arts_and_humanities' => 'Arts and Humanities',
        'sciences' => 'Sciences',
        'health_sciences' => 'Health Sciences',
        'social_and_legal_sciences' => 'Social and Legal Sciences',
        'engineering_and_architecture' => 'Engineering and Architecture',
      ],
      'fr' => [
        'arts_and_humanities' => 'Arts et Humanités',
        'sciences' => 'Sciences',
        'health_sciences' => 'Sciences de la Santé',
        'social_and_legal_sciences' => 'Sciences Sociales et Juridiques',
        'engineering_and_architecture' => 'Ingénierie et Architecture',
      ],
      'pt-pt' => [
        'arts_and_humanities' => 'Artes e Humanidades',
        'sciences' => 'Ciências',
        'health_sciences' => 'Ciências da Saúde',
        'social_and_legal_sciences' => 'Ciências Sociais e Jurídicas',
        'engineering_and_architecture' => 'Engenharia e Arquitetura',
      ],
      'gl' => [
        'arts_and_humanities' => 'Artes e Humanidades',
        'sciences' => 'sciences',
        'health_sciences' => 'sciences da Saúde',
        'social_and_legal_sciences' => 'sciences Sociais e Xurídicas',
        'engineering_and_architecture' => 'Enxeñería e Arquitectura',
      ],
      'hu' => [
        'arts_and_humanities' => 'Művészetek és Bölcsészettudományok',
        'sciences' => 'Tudományok',
        'health_sciences' => 'Egészségtudományok',
        'social_and_legal_sciences' => 'Társadalmi és Jogtudományok',
        'engineering_and_architecture' => 'Mérnöki és Építészeti Tudományok',
      ],
      'sl' => [
        'arts_and_humanities' => 'Umetnost in Humanistika',
        'sciences' => 'Znanost',
        'health_sciences' => 'Zdravstvene vede',
        'social_and_legal_sciences' => 'Družbene in Pravne Znanosti',
        'engineering_and_architecture' => 'Inženiring in Arhitektura',
      ],
      'et' => [
        'arts_and_humanities' => 'Kunst ja Humanitaarteadused',
        'sciences' => 'Teadused',
        'health_sciences' => 'Tervishoiuteadused',
        'social_and_legal_sciences' => 'Sotsiaal- ja Õigusteadused',
        'engineering_and_architecture' => 'Inseneriteadus ja Arhitektuur',
      ],
      'el' => [
        'arts_and_humanities' => 'Τέχνες και Ανθρωπιστικές Επιστήμες',
        'sciences' => 'Επιστήμες',
        'health_sciences' => 'Επιστήμες Υγείας',
        'social_and_legal_sciences' => 'Κοινωνικές και Νομικές Επιστήμες',
        'engineering_and_architecture' => 'Μηχανική και Αρχιτεκτονική',
      ],
    ];
    $variables['programme_area_labels'] = $map[$langcode] ?? $map['en'];

    $variables['selected_home_programme'] = NULL;
    $variables['clear_home_programme_url'] = NULL;
    \Drupal\Core\Cache\CacheableMetadata::createFromRenderArray($variables)
      ->addCacheContexts(['url.query_args:home_programme'])
      ->applyTo($variables);

    $home_programme_id = \Drupal::request()->query->get('home_programme');
    if ($home_programme_id && is_numeric($home_programme_id)) {
      $home_programme = Node::load((int) $home_programme_id);

      if ($home_programme instanceof NodeInterface && $home_programme->bundle() === 'programme') {
        $home_programme = b5subtheme_entity_for_language_with_fallback($home_programme, $langcode);
        $home_programme_label = $home_programme->label();
        $home_institution_label = '';

        if ($home_programme->hasField('field_programme_institution') && !$home_programme->get('field_programme_institution')->isEmpty()) {
          $home_institution = $home_programme->get('field_programme_institution')->entity;
          $home_institution = b5subtheme_entity_for_language_with_fallback($home_institution, $langcode);
          $home_institution_label = $home_institution ? $home_institution->label() : '';
        }

        $variables['selected_home_programme'] = [
          'label' => $home_programme_label,
          'institution' => $home_institution_label,
        ];

        $query_params = \Drupal::request()->query->all();
        unset($query_params['home_programme'], $query_params['page']);

        $variables['clear_home_programme_url'] = Url::fromRoute('view.search_programme.page_1', [], [
          'query' => $query_params,
          'language' => \Drupal::languageManager()->getLanguage($langcode),
        ])->toString();
      }
    }









    foreach ($variables['view']->result as $row) {
      $programme = $row->_entity ?? NULL;
      if (!$programme) {
        continue;
      }

      $lang_for_url = b5subtheme_entity_language_for_url($programme, $langcode);
      $language = \Drupal::languageManager()->getLanguage($lang_for_url);
      $programme_t = b5subtheme_entity_for_language_with_fallback($programme, $langcode);
      $row->_entity = $programme_t;
      $row->display_instruction_languages = b5subtheme_referenced_entity_labels_for_language($programme_t, 'field_programme_language_of_inst', $lang_for_url);

      // Institution del programme.
      if (
        !$programme_t->hasField('field_programme_institution') ||
        $programme_t->get('field_programme_institution')->isEmpty()
      ) {
        continue;
      }
      $inst = $programme_t->get('field_programme_institution')->entity;
      $inst = b5subtheme_entity_for_language_with_fallback($inst, $lang_for_url);
      if (!$inst) {
        continue;
      }
      $row->display_institution = $inst;

      // Aliases (último segmento de la URL canónica traducida).
      $prog_canonical = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $programme_t->id()], ['language' => $language])->toString();
      $inst_canonical = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $inst->id()], ['language' => $language])->toString();

      $programme_alias = basename(trim($prog_canonical, '/'));
      $institution_alias = basename(trim($inst_canonical, '/'));

      // /lang/alias_institution/catalogue/alias_programme_actual
      $row->programme_url = '/' . $lang_for_url . '/catalogue/' . $institution_alias . '/' . $programme_alias;
    }
































  }



  if ($variables['view']->id() === 'search_iec') {
    $branding = \Drupal::service('settings')->get('site_branding', []);
    $variables['search_site_primary_color'] = $branding['primary_color'] ?? '#ff4949';

    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

    // Países traducidos (Address).
    $variables['country_list'] = \Drupal::service('address.country_repository')->getList($langcode);




    $current_language = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();

  foreach ($variables['view']->result as &$row) {
    /** @var \Drupal\node\NodeInterface|null $iec */
    $iec = $row->_entity ?? NULL;

    if (!$iec instanceof NodeInterface || !$iec->id()) {
      
      continue;
    }

    $lang_for_url = b5subtheme_entity_language_for_url($iec, $current_language);
    $language = \Drupal::languageManager()->getLanguage($lang_for_url);

    $iec_for_url = b5subtheme_entity_for_language_with_fallback($iec, $current_language);
    $row->_entity = $iec_for_url;
    $row->display_instruction_languages = b5subtheme_referenced_entity_labels_for_language($iec_for_url, 'field_iec_language_of_instructio', $lang_for_url);

    if ($iec_for_url->hasField('field_iec_programme') && !$iec_for_url->get('field_iec_programme')->isEmpty()) {
      $programme = $iec_for_url->get('field_iec_programme')->entity;
      $programme = b5subtheme_entity_for_language_with_fallback($programme, $current_language);
      $row->display_programme = $programme;

      if ($programme && $programme->hasField('field_programme_institution') && !$programme->get('field_programme_institution')->isEmpty()) {
        $institution = $programme->get('field_programme_institution')->entity;
        $row->display_institution = b5subtheme_entity_for_language_with_fallback($institution, $current_language);
      }
    }

    // Genera la URL canónica en el idioma adecuado
    $url = $iec_for_url
      ->toUrl('canonical', ['language' => $language])
      ->toString();

    // Si la URL viene ya con prefijo /xx, lo quitamos para evitar duplicados
    if (strpos($url, '/' . $lang_for_url) === 0) {
      $url = substr($url, strlen('/' . $lang_for_url));
    }

    // Construir la nueva URL con el formato correcto: /<lang_for_url>/catalogue/<...>
    // (Nota: pongo "/" al principio para que sea una ruta absoluta correcta)
    $row->custom_url = '/' . $lang_for_url . '/catalogue' . $url;
  }




  }











}





/* Implements hook_theme_registry_alter().
 */
function b5subtheme_theme_registry_alter(&$theme_registry)
{
  \Drupal::service('twig.loader.filesystem')->addPath(
    DRUPAL_ROOT . '/modules/custom/dacem_footer/templates',
    'dacem_footer'
  );
}



use Drupal\Core\Form\FormStateInterface;

function b5subtheme_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
  $view = $form_state->getBuildInfo()['callback_object']->view ?? NULL;
  if ($view && $view->id() === 'alliances') {
    if (isset($form['title'])) {
      $form['title']['#attributes']['placeholder'] = t('Type here to search');
      $form['title']['#title_display'] = 'invisible';
    }

    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Search');
    }
  }

  if ($view && $view->id() === 'main_page' && $view->current_display === 'page_2') {
    if (isset($form['title'])) {
      $form['title']['#attributes']['placeholder'] = t('Type here to search');
      $form['title']['#title_display'] = 'invisible';
    }
  }

  if ($view && $view->id() === 'search_programme') {
    // En el form
    $form['#attributes']['data-disable-refocus'] = 'true';

    $request = \Drupal::request();
    $home_programme_id = $request->query->get('home_programme');
    $reset_requested = $request->query->get('op') === 'Reset';

    if (!$reset_requested && $home_programme_id && is_numeric($home_programme_id)) {
      $form['home_programme'] = [
        '#type' => 'hidden',
        '#value' => (int) $home_programme_id,
        '#attributes' => [
          'data-home-programme-filter' => '1',
        ],
      ];
    }

    if (isset($form['actions']['reset'])) {
      if ($home_programme_id && is_numeric($home_programme_id)) {
        $form['actions']['reset']['#access'] = TRUE;
      }

      $form['actions']['reset']['#attributes']['data-clear-home-programme'] = '1';
      $form['actions']['reset']['#attributes']['data-reset-url'] = Url::fromRoute('view.search_programme.page_1', [], [
        'language' => \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT),
      ])->toString();
    }

    // En todos los hijos del form (inputs/selects)
    array_walk_recursive($form, function (&$value, $key) {
      if ($key === '#attributes') {
        $value['data-disable-refocus'] = 'true';
      }
    });
    // En el botón submit, por si acaso
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['data-disable-refocus'] = 'true';
    }
  }
}








use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_pre_render().
 */
function b5subtheme_views_pre_render(ViewExecutable $view) {
  if ($view->id() !== 'institution_new_catalogue') {
    return;
  }

  if ($view->current_display === 'page_1' || $view->current_display === 'page_3') {
    $current_language = \Drupal::languageManager()
      ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
      ->getId();

    foreach ($view->result as &$row) {
      /** @var \Drupal\node\NodeInterface|null $programme */
      $programme = $row->_entity ?? NULL;

      if (!$programme || !$programme->id()) {
        \Drupal::logger('catalogue_debug')->warning('Row without valid programme entity.');
        continue;
      }

      $lang_for_url = b5subtheme_entity_language_for_url($programme, $current_language);
      $language = \Drupal::languageManager()->getLanguage($lang_for_url);
      $programme_for_url = b5subtheme_entity_for_language_with_fallback($programme, $current_language);
      $row->_entity = $programme_for_url;
      $row->display_instruction_languages = b5subtheme_referenced_entity_labels_for_language($programme_for_url, 'field_programme_language_of_inst', $lang_for_url);

      if (
        !$programme_for_url->hasField('field_programme_institution') ||
        $programme_for_url->get('field_programme_institution')->isEmpty()
      ) {
        \Drupal::logger('catalogue_debug')->warning('Programme @nid has no institution reference.', [
          '@nid' => $programme_for_url->id(),
        ]);
        continue;
      }

      /** @var \Drupal\node\NodeInterface|null $institution */
      $institution = $programme_for_url->get('field_programme_institution')->entity;
      $institution = b5subtheme_entity_for_language_with_fallback($institution, $lang_for_url);
      if (!$institution || !$institution->id()) {
        \Drupal::logger('catalogue_debug')->warning('Programme @nid has invalid institution entity.', [
          '@nid' => $programme_for_url->id(),
        ]);
        continue;
      }

      $institution_for_url = $institution;
      $row->display_institution = $institution_for_url;

      if ($programme_for_url->hasField('field_programme_ou') && !$programme_for_url->get('field_programme_ou')->isEmpty()) {
        $ou = $programme_for_url->get('field_programme_ou')->entity;
        $row->display_ou = b5subtheme_entity_for_language_with_fallback($ou, $lang_for_url);
      }

      $programme_canonical = Url::fromRoute('entity.node.canonical', ['node' => $programme_for_url->id()], ['language' => $language])->toString();
      $institution_canonical = Url::fromRoute('entity.node.canonical', ['node' => $institution_for_url->id()], ['language' => $language])->toString();

      $programme_slug = basename(trim($programme_canonical, '/'));
      $institution_slug = basename(trim($institution_canonical, '/'));

      $row->custom_url = '/' . $lang_for_url
        . '/catalogue/'
        . $institution_slug
        . '/'
        . $programme_slug;

      \Drupal::logger('catalogue_debug')->notice('Generated custom_url for @display nid @nid: @url', [
        '@display' => $view->current_display,
        '@nid' => $programme_for_url->id(),
        '@url' => $row->custom_url,
      ]);
    }
  }

  if ($view->current_display === 'page_2') {
    $current_language = \Drupal::languageManager()
      ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
      ->getId();

    foreach ($view->result as &$row) {
      /** @var \Drupal\node\NodeInterface|null $iec */
      $iec = $row->_entity ?? NULL;

      if (!$iec instanceof NodeInterface || !$iec->id()) {
        continue;
      }

      $lang_for_url = b5subtheme_entity_language_for_url($iec, $current_language);
      $language = \Drupal::languageManager()->getLanguage($lang_for_url);

      $iec_for_url = b5subtheme_entity_for_language_with_fallback($iec, $current_language);
      $row->_entity = $iec_for_url;
      $row->display_instruction_languages = b5subtheme_referenced_entity_labels_for_language($iec_for_url, 'field_iec_language_of_instructio', $lang_for_url);

      if ($iec_for_url->hasField('field_iec_programme') && !$iec_for_url->get('field_iec_programme')->isEmpty()) {
        $programme = $iec_for_url->get('field_iec_programme')->entity;
        $programme = b5subtheme_entity_for_language_with_fallback($programme, $current_language);
        $row->display_programme = $programme;
      }

      // Genera la URL canónica en el idioma adecuado.
      $url = $iec_for_url
        ->toUrl('canonical', ['language' => $language])
        ->toString();

      // Si la URL viene ya con prefijo /xx, lo quitamos para evitar duplicados.
      if (strpos($url, '/' . $lang_for_url) === 0) {
        $url = substr($url, strlen('/' . $lang_for_url));
      }

      // Construir la nueva URL con el formato correcto: /<lang_for_url>/catalogue/<...>
      $row->custom_url = '/' . $lang_for_url . '/catalogue' . $url;

      \Drupal::logger('catalogue_debug')->notice('Generated custom_url for page_2 nid @nid: @url', [
        '@nid' => $iec_for_url->id(),
        '@url' => $row->custom_url,
      ]);
    }
  }
}
