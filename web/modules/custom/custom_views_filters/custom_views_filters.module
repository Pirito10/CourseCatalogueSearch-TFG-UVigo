 * Crear ORGANIZATIONAL UNIT.
 */
function custom_views_filters_form_node_organizational_unit_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
  \Drupal::logger('custom_views_filters')->info('custom_views_filters_form_node_organizational_unit_edit_form_alter jjjjaaaaaaajj');

  _custom_views_filters_alter_organizational_unit_form($form, $form_state, $form_id);
}

/**
 * Editar ORGANIZATIONAL UNIT.
 */
function custom_views_filters_form_node_organizational_unit_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
  \Drupal::logger('custom_views_filters')->info('EDIT: form_node_organizational_unit_edit_form_alter');
  _custom_views_filters_alter_organizational_unit_form($form, $form_state, $form_id);
}


/**
 * Lógica común para creación y edición de organizational_unit.
 */
function _custom_views_filters_alter_organizational_unit_form(array &$form, FormStateInterface $form_state, $form_id)
{
  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->bundle() !== 'organizational_unit') {
    return;
  }

  // 1) Obtener el grupo.
  $route_match = \Drupal::routeMatch();
  $group_param = $route_match->getParameter('group');
  $group = NULL;

  if (is_object($group_param)) {
    $group = $group_param;
  } elseif (is_numeric($group_param)) {
    $group = \Drupal::entityTypeManager()->getStorage('group')->load((int) $group_param);
  }

  $gr_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');

  // Si no viene por la ruta (caso /node/{nid}/edit), miramos la relación del nodo.
  if (!$group && !$node->isNew()) {
    $ou_rels = $gr_storage->loadByProperties([
      'entity_id' => $node->id(),
      'plugin_id' => 'group_node:organizational_unit',
    ]);
    if ($ou_rel = reset($ou_rels)) {
      if (method_exists($ou_rel, 'getGroup')) {
        $group = $ou_rel->getGroup();
      }
    }
  }

  if (!$group) {
    // Fuera de contexto de grupo, no forzamos nada.
    return;
  }

  // 2) Obtener INSTITUTION del grupo.
  $inst_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:institution',
  ]);

  $institution_options = [];
  $institution_nid = NULL;

  foreach ($inst_rels as $rel) {
    $entity = NULL;
    if (method_exists($rel, 'getEntity')) {
      $entity = $rel->getEntity();
    } elseif (method_exists($rel, 'getContentEntity')) {
      $entity = $rel->getContentEntity();
    }
    if ($entity && $entity->bundle() === 'institution') {
      $institution_options[$entity->id()] = $entity->label();
      $institution_nid = $entity->id();
    }
  }

  // 3) CAMPUS del grupo.
  $campus_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:campus',
  ]);

  $campus_options = [];
  foreach ($campus_rels as $rel) {
    $campus = NULL;
    if (method_exists($rel, 'getEntity')) {
      $campus = $rel->getEntity();
    } elseif (method_exists($rel, 'getContentEntity')) {
      $campus = $rel->getContentEntity();
    }
    if ($campus && $campus->bundle() === 'campus') {
      if ($institution_nid && $campus->hasField('field_campus_institution') && !$campus->get('field_campus_institution')->isEmpty()) {
        $ref = (int) $campus->get('field_campus_institution')->target_id;
        if ($ref !== (int) $institution_nid) {
          continue;
        }
      }
      $campus_options[$campus->id()] = $campus->label();
    }
  }

  // 4) ORGANIZATIONAL UNITS raíz (sin padre).
  $organizational_unit_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:organizational_unit',
  ]);

  $organizational_unit_options = [];

  foreach ($organizational_unit_rels as $rel) {
    $org_unit = NULL;

    if (method_exists($rel, 'getEntity')) {
      $org_unit = $rel->getEntity();
    } elseif (method_exists($rel, 'getContentEntity')) {
      $org_unit = $rel->getContentEntity();
    }

    if ($org_unit && $org_unit->bundle() === 'organizational_unit') {
      if (
        $org_unit->hasField('field_parent_organizational_unit')
        && $org_unit->get('field_parent_organizational_unit')->isEmpty()
      ) {

        $organizational_unit_options[$org_unit->id()] = $org_unit->label();
      }
    }
  }

  // === Institution bloqueada (si tienes el campo en el form) ===
  if (isset($form['field_ou_institution']['widget'][0]['target_id'])) {
    $el =& $form['field_ou_institution']['widget'][0]['target_id'];

    $el['#type'] = 'select';
    $el['#multiple'] = FALSE;
    $el['#size'] = 1;
    $el['#options'] = $institution_options;
    $el['#required'] = TRUE;
    $el['#disabled'] = TRUE;

    if ($institution_nid) {
      $el['#default_value'] = $institution_nid;
    }

    unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);
  }

  // === Campus select ===
  // === Campus select ===
  if (isset($form['field_ou_campus']['widget'][0]['target_id'])) {
    $el =& $form['field_ou_campus']['widget'][0]['target_id'];

    $el['#type'] = 'select';
    $el['#multiple'] = FALSE;
    $el['#size'] = 1;

    $el['#options'] = $campus_options;
    $el['#empty_option'] = t('- None -');
    $el['#empty_value'] = '_none';
    $el['#required'] = FALSE;

    // 👇 IMPORTANTE: asegurar default_value como ID, no como objeto.
    if (!$node->isNew() && !$node->get('field_ou_campus')->isEmpty()) {
      $el['#default_value'] = $node->get('field_ou_campus')->target_id;
    } else {
      $el['#default_value'] = '_none';
    }

    unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);

    $el['#element_validate'][] = 'custom_views_filters_er_select_empty_to_null';
  }


  // === Parent Organizational Unit select (solo raíz) ===
  if (isset($form['field_parent_organizational_unit']['widget'][0]['target_id'])) {
    $el =& $form['field_parent_organizational_unit']['widget'][0]['target_id'];

    $el['#type'] = 'select';
    $el['#multiple'] = FALSE;
    $el['#size'] = 1;

    $el['#options'] = $organizational_unit_options;
    $el['#empty_option'] = t('- None -');
    $el['#empty_value'] = '_none';
    $el['#required'] = FALSE;

    // 👇 Igual que antes: ID, no objeto.
    if (!$node->isNew() && !$node->get('field_parent_organizational_unit')->isEmpty()) {
      $el['#default_value'] = $node->get('field_parent_organizational_unit')->target_id;
    } else {
      $el['#default_value'] = '_none';
    }

    unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);

    $el['#element_validate'][] = 'custom_views_filters_er_select_empty_to_null';
  }

}








/**
 * Academic Authority create/edit form alter.
 */
function custom_views_filters_form_node_programme_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{

  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->bundle() !== 'programme') {
    return;
  }

  // 1) Obtener el grupo desde la ruta /group/{group}/content/create/...
  $route_match = \Drupal::routeMatch();
  $group_param = $route_match->getParameter('group');
  $group = NULL;
  if (is_object($group_param)) {
    $group = $group_param;
  } elseif (is_numeric($group_param)) {
    $group = \Drupal::entityTypeManager()->getStorage('group')->load((int) $group_param);
  }
  if (!$group) {
    // Fuera de contexto de grupo, no forzamos nada.
    return;
  }

  // 2) Obtener INSTITUTION del grupo vía group_relationship.
  //    Plugin id para nodos "institution": group_node:institution
  $gr_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');

  $inst_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:institution',
  ]);

  $institution_options = [];
  $institution_nid = NULL;

  foreach ($inst_rels as $rel) {
    // Compatibilidad: Group v3 expone métodos diferentes según versión,
    // intentamos ambos de forma segura.
    $entity = NULL;
    if (method_exists($rel, 'getEntity')) {
      $entity = $rel->getEntity();
    } elseif (method_exists($rel, 'getContentEntity')) {
      $entity = $rel->getContentEntity();
    }
    if ($entity && $entity->bundle() === 'institution') {
      $institution_options[$entity->id()] = $entity->label();
      $institution_nid = $entity->id();
    }
  }

  // 3) Obtener CAMPUS del grupo (plugin group_node:campus).
  $campus_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:campus',
  ]);

  //Obter Org Units do grupo

  $org_unit_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:organizational_unit',
  ]);

  $org_unit_options = [];
  foreach ($org_unit_rels as $rel) {
    $organizational_unit = NULL;
    if (method_exists($rel, 'getEntity')) {
      $organizational_unit = $rel->getEntity();
    } elseif (method_exists($rel, 'getContentEntity')) {
      $organizational_unit = $rel->getContentEntity();
    }
    if ($organizational_unit && $organizational_unit->bundle() === 'organizational_unit') {
      // Si quieres filtrar solo los campus que referencian a ESA institution (opcional):
      if ($institution_nid && $organizational_unit->hasField('field_ou_institution') && !$organizational_unit->get('field_ou_institution')->isEmpty()) {
        $ref = (int) $organizational_unit->get('field_ou_institution')->target_id;
        if ($ref !== (int) $institution_nid) {
          continue;
        }
      }
      $org_unit_options[$organizational_unit->id()] = $organizational_unit->label();
    }
  }



  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();

  if (class_exists(\Collator::class)) {
    $coll = new \Collator($langcode);

    uasort($org_unit_options, function ($a, $b) use ($coll) {
      return $coll->compare((string) $a, (string) $b);
    });
  }


  // === Organizational Unit: forzar opciones filtradas en el select ===
  if (isset($form['field_programme_ou']['widget'][0]['target_id'])) {
    $el =& $form['field_programme_ou']['widget'][0]['target_id'];

    $el['#type'] = 'select';
    $el['#multiple'] = FALSE;
    $el['#size'] = 1;

    // 👇 Solo campus del grupo (y si quieres, filtrados por la institution del grupo)
    $el['#options'] = $org_unit_options;
    $el['#empty_option'] = t('- None -');
    $el['#empty_value'] = '_none';
    $el['#required'] = TRUE;


    unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);

    $el['#element_validate'][] = 'custom_views_filters_er_select_empty_to_null';
  }




}

/**
 * Agreement create form alter.
 */
function custom_views_filters_form_node_agreement_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  _custom_views_filters_alter_agreement_form($form, $form_state);
}

/**
 * Agreement edit form alter.
 */
function custom_views_filters_form_node_agreement_edit_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  _custom_views_filters_alter_agreement_form($form, $form_state);
}

/**
 * Common logic for agreement forms.
 */
function _custom_views_filters_alter_agreement_form(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node || $node->bundle() !== 'agreement') {
    return;
  }

  $route_match = \Drupal::routeMatch();
  $group_param = $route_match->getParameter('group');
  $group = NULL;

  if (is_object($group_param)) {
    $group = $group_param;
  }
  elseif (is_numeric($group_param)) {
    $group = \Drupal::entityTypeManager()->getStorage('group')->load((int) $group_param);
  }

  $gr_storage = \Drupal::entityTypeManager()->getStorage('group_relationship');

  if (!$group && !$node->isNew()) {
    $agreement_rels = $gr_storage->loadByProperties([
      'entity_id' => $node->id(),
      'plugin_id' => 'group_node:agreement',
    ]);

    if ($agreement_rel = reset($agreement_rels)) {
      if (method_exists($agreement_rel, 'getGroup')) {
        $group = $agreement_rel->getGroup();
      }
    }
  }

  if (!$group) {
    return;
  }

  $inst_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:institution',
  ]);

  $institution_nid = NULL;
  foreach ($inst_rels as $rel) {
    $entity = NULL;

    if (method_exists($rel, 'getEntity')) {
      $entity = $rel->getEntity();
    }
    elseif (method_exists($rel, 'getContentEntity')) {
      $entity = $rel->getContentEntity();
    }

    if ($entity && $entity->bundle() === 'institution') {
      $institution_nid = $entity->id();
      break;
    }
  }

  $org_unit_rels = $gr_storage->loadByProperties([
    'gid' => $group->id(),
    'plugin_id' => 'group_node:organizational_unit',
  ]);

  $org_unit_options = [];
  foreach ($org_unit_rels as $rel) {
    $organizational_unit = NULL;

    if (method_exists($rel, 'getEntity')) {
      $organizational_unit = $rel->getEntity();
    }
    elseif (method_exists($rel, 'getContentEntity')) {
      $organizational_unit = $rel->getContentEntity();
    }

    if ($organizational_unit && $organizational_unit->bundle() === 'organizational_unit') {
      if ($institution_nid && $organizational_unit->hasField('field_ou_institution') && !$organizational_unit->get('field_ou_institution')->isEmpty()) {
        $ref = (int) $organizational_unit->get('field_ou_institution')->target_id;
        if ($ref !== (int) $institution_nid) {
          continue;
        }
      }

      $org_unit_options[$organizational_unit->id()] = $organizational_unit->label();
    }
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if (class_exists(\Collator::class)) {
    $coll = new \Collator($langcode);
    uasort($org_unit_options, function ($a, $b) use ($coll) {
      return $coll->compare((string) $a, (string) $b);
    });
  }

  if (isset($form['field_department_partner_1']['widget'][0]['target_id'])) {
    $el =& $form['field_department_partner_1']['widget'][0]['target_id'];

    $el['#type'] = 'select';
    $el['#multiple'] = FALSE;
    $el['#size'] = 1;
    $el['#options'] = $org_unit_options;
    $el['#empty_option'] = t('- None -');
    $el['#empty_value'] = '_none';
    $el['#required'] = FALSE;

    if (!$node->isNew() && !$node->get('field_department_partner_1')->isEmpty()) {
      $el['#default_value'] = $node->get('field_department_partner_1')->target_id;
    }
    else {
      $el['#default_value'] = '_none';
    }

    unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);
    $el['#element_validate'][] = 'custom_views_filters_er_select_empty_to_null';
  }

  if (isset($form['field_institution_2']['widget'][0]['target_id'])) {
    $form['field_institution_2']['widget'][0]['target_id']['#ajax'] = [
      'callback' => 'custom_views_filters_agreement_department_partner_2_ajax',
      'event' => 'change',
      'wrapper' => 'agreement-department-partner-2-wrapper',
    ];
  }

  if (isset($form['field_department_partner_2'])) {
    $form['field_department_partner_2']['#prefix'] = '<div id="agreement-department-partner-2-wrapper">';
    $form['field_department_partner_2']['#suffix'] = '</div>';
  }

  if (isset($form['field_department_partner_2']['widget'][0]['target_id'])) {
    $el =& $form['field_department_partner_2']['widget'][0]['target_id'];
    $selected_institution_2_id = custom_views_filters_get_selected_agreement_institution_2_id($form_state, $node);
    $org_unit_options_2 = custom_views_filters_get_org_unit_options_for_institution($selected_institution_2_id);

    $el['#type'] = 'select';
    $el['#multiple'] = FALSE;
    $el['#size'] = 1;
    $el['#options'] = $org_unit_options_2;
    $el['#empty_option'] = t('- None -');
    $el['#empty_value'] = '_none';
    $el['#required'] = FALSE;

    $current_department_2 = (!$node->isNew() && !$node->get('field_department_partner_2')->isEmpty())
      ? (string) $node->get('field_department_partner_2')->target_id
      : '_none';

    $submitted_department_2 = $form_state->getValue(['field_department_partner_2', 0, 'target_id']);
    if ($submitted_department_2 !== NULL && $submitted_department_2 !== '') {
      $current_department_2 = (string) $submitted_department_2;
    }

    $el['#default_value'] = array_key_exists($current_department_2, $org_unit_options_2) ? $current_department_2 : '_none';

    unset($el['#selection_handler'], $el['#selection_settings'], $el['#autocomplete_route_name']);
    $el['#element_validate'][] = 'custom_views_filters_er_select_empty_to_null';
  }
}

/**
 * Ajax callback for refreshing agreement destination OUs.
 */
function custom_views_filters_agreement_department_partner_2_ajax(array &$form, FormStateInterface $form_state) {
  $form_state->setRebuild(TRUE);
  return $form['field_department_partner_2'];
}

/**
 * Resolves selected institution 2 from current form state or entity.
 */
function custom_views_filters_get_selected_agreement_institution_2_id(FormStateInterface $form_state, Node $node): ?int {
  $user_input = $form_state->getUserInput();

  if (!empty($user_input['field_institution_2'][0]['target_id']) && is_string($user_input['field_institution_2'][0]['target_id'])) {
    $entity_id = EntityAutocomplete::extractEntityIdFromAutocompleteInput($user_input['field_institution_2'][0]['target_id']);
    if ($entity_id) {
      return (int) $entity_id;
    }
  }

  $submitted_value = $form_state->getValue(['field_institution_2', 0, 'target_id']);

  if (is_string($submitted_value) && $submitted_value !== '') {
    $entity_id = EntityAutocomplete::extractEntityIdFromAutocompleteInput($submitted_value);
    if ($entity_id) {
      return (int) $entity_id;
    }
  }

  if (is_array($submitted_value) && isset($submitted_value[0]['target_id']) && is_numeric($submitted_value[0]['target_id'])) {
    return (int) $submitted_value[0]['target_id'];
  }

  if (!$node->isNew() && $node->hasField('field_institution_2') && !$node->get('field_institution_2')->isEmpty()) {
    return (int) $node->get('field_institution_2')->target_id;
  }

  return NULL;
}

/**
 * Returns organizational units belonging to one institution.
 */
function custom_views_filters_get_org_unit_options_for_institution(?int $institution_id): array {
  if (!$institution_id) {
    return [];
  }

  $org_units = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
    'type' => 'organizational_unit',
    'field_ou_institution' => $institution_id,
  ]);

  $options = [];
  foreach ($org_units as $org_unit) {
    if ($org_unit instanceof Node) {
      $options[(string) $org_unit->id()] = $org_unit->label();
    }
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if (class_exists(\Collator::class)) {
    $coll = new \Collator($langcode);
    uasort($options, function ($a, $b) use ($coll) {
      return $coll->compare((string) $a, (string) $b);
    });
  }

  return $options;
}











/**
 * Convierte el valor vacío del select de entity reference a NULL.
 * Se ejecuta en el elemento 'target_id' antes de la validación del campo.
 */
function custom_views_filters_er_select_empty_to_null(array &$element, FormStateInterface $form_state, array &$form)
{
  // Los padres apuntan exactamente a field_aa_campus][0][target_id]
  $parents = $element['#parents']; // ['field_aa_campus', 0, 'target_id']
  $value = $form_state->getValue($parents);

  if ($value === '' || $value === '_none' || $value === 0 || $value === '0') {
    // El entity reference espera NULL para "vacío"
    $form_state->setValue($parents, NULL);
  }
}












/**
 * Implements hook_entity_operation_alter().
 */
function custom_views_filters_entity_operation_alter(array &$operations, \Drupal\Core\Entity\EntityInterface $entity)
{
  // Solo para nodos.


  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }

  // Por ejemplo, solo para el tipo 'programme' (opcional).
  // if ($entity->bundle() !== 'programme') {
  //   return;
  // }

  // Limitar a una vista concreta (opcional).
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();


  // Sustituye por el ID de tu vista y display (page_1, block_1, etc).
  $views_to_block = in_array($route_name, [
    'view.admin_rs.page_1',

  ]);

  if (!$views_to_block) {
    return;
  }

  // Eliminar el enlace "Delete".
  unset($operations['delete']);
}
