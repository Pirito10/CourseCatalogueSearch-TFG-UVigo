{% if institution.field_institution_picture is not empty %}
	{% if institution.field_institution_picture is not empty %}
		{% set file = institution.field_institution_picture.entity %}
		{% if file %}
			{% set uri = file.getFileUri() %}
			{% set image_url = file_url(uri) %}
			<div class='university-photo'>
				<img src="{{ image_url }}" alt="University Logo" class="university-img"/>
			</div>
		{% endif %}
	{% endif %}
{% endif %}</div><div class="container-fluid">
<div class="section-container">
	<div class="my-custom-container-2">

		<div class="spacer"></div>
		<div class="university-details">

			<h1 class="section-title">{{institution.title.value}}</h1>

			{% if country_name %}
				<h5 style="color: red;">{{country_name}}</h5>
			{% else %}
				<p>
					<strong>{{ 'Country'|t }}:</strong>
					{{ 'Not available'|t }}</p>
			{% endif %}

			{% set current_language = institution.langcode.value %}

			<div
				class="row" id="description" style="scroll-margin-top: 200px;">
				<!-- Parte izquierda con información de la universidad -->
				<div class="col-12 col-lg-8 order-2 order-lg-1">
					{% if institution.field_information.value is not empty %}

						<div class="university-info">
							<p>{{ institution.field_information.value | raw}}</p>
						</div>
					{% else %}
						<p>
							<strong>{{ 'Information'|t }}:</strong>
							{{ 'Not available'|t }}</p>
					{% endif %}

					{#{dump(institution.field_institution_map[0].lon)}#}


					<!-- Academic Terms debajo de la info -->
					<div class="mt-4">
						{% if institution.field_admission_language_policy is not empty %}
							<h4 class="subsection-title">{{ 'Languages'|t }}</h4>
							<p>{{ institution.field_admission_language_policy.value | raw}}</p>
						{% endif %}

						{% if institution.field_academic_calendar.value is defined and institution.field_academic_calendar.value %}

							<h4 class="subsection-title">{{ 'Academic Calendar'|t }}</h4>

							{{institution.field_academic_calendar.value | raw}}
						{% endif %}
					</div>
				</div>

				<!-- Parte derecha con logo y contacto -->
				<div class="col-12 col-lg-4 order-1 order-lg-2">

					<div
						class="degree-sidebar bg-light p-4">

						<!-- Logo (field_logo como media) -->
						<div class="d-flex justify-content-center">
							{% if institution.field_logo.entity.uri.value is defined %}
								<img src="{{ file_url(institution.field_logo.entity.uri.value) }}" alt="{{ institution.label() }} logo" class="institution-logo">
							{% endif %}

						</div>
						<div class="institution-card-information">

							{% if institution.field_institution_webpage.uri is defined and institution.field_institution_webpage.uri %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-globe me-2 mt-1"></i>
									<p class="mb-0">
										<a href="{{ institution.field_institution_webpage.uri }}" target="_blank">
											{{ institution.field_institution_webpage.title ?: institution.field_institution_webpage.uri }}
										</a>
									</p>
								</div>
							{% endif %}

							{% if institution.field_institution_email.value is defined and institution.field_institution_email.value %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-envelope me-2 mt-1"></i>
									<p class="mb-0">
										<a href="mailto:{{ institution.field_institution_email.value }}" class="text-dark text-decoration-none">
											{{ institution.field_institution_email.value }}
										</a>
									</p>
								</div>
							{% endif %}


							{% if institution.field_institution_phone.value is defined and institution.field_institution_phone.value %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-phone-alt me-2 mt-1"></i>
									<p class="mb-0">
										<a href="tel:{{ institution.field_institution_phone.value }}" class="text-dark text-decoration-none">
											{{ institution.field_institution_phone.value }}
										</a>
									</p>
								</div>
							{% endif %}


							{% if institution.field_institution_address.value is defined and institution.field_institution_address.value %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-map-marker-alt me-2 mt-1"></i>
									<p class="mb-0">{{ institution.field_institution_address.value }}</p>
								</div>
							{% endif %}


							{% set coords = [] %}
							{% if institution.hasField('field_institution_map') and institution.field_institution_map.value %}
								{% set point = institution.field_institution_map.value %}
								{% if point %}
									{% set coords = point|replace({'POINT(':'','POINT (':'', ')':''})|trim|split(' ') %}
								{% endif %}
							{% endif %}
							{% if coords is not empty %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-map-marker-alt me-2 mt-1"></i>
									<p class="mb-0">{{ coords[1]|default('') }},
										{{ coords[0]|default('') }}</p>
								</div>
							{% endif %}

              {% if general_information_alliance %}
                {% set alliance_logo = general_information_alliance.field_alliance_logo.entity %}
                <div class="institution-alliance-membership">
                  <p class="institution-alliance-membership__label">{{ 'Member of alliance:'|t }}</p>
                  <a href="{{ path('view.alliance_institutions.page_1', {'arg_0': general_information_alliance.id()}) }}" class="institution-alliance-membership__link">
                    {% if alliance_logo %}
                      <img src="{{ file_url(alliance_logo.getFileUri()) }}" alt="{{ general_information_alliance.label() }}">
                    {% else %}
                      <span>{{ general_information_alliance.label() }}</span>
                    {% endif %}
                  </a>
                </div>
              {% endif %}

						</div>

					</div>
				</div>

			</div>


		</div>

	</div>
</div>


{% if aa_results|length > 0 %}
	{{ drupal_block('views_block:academic_authority-block_1') }}
{% endif %}


<div class="section-container">
	<div class="my-custom-container-2" id="mobility" style="scroll-margin-top: 150px;">

		{% set has_incoming = institution.field_mobility_incoming_students is not empty %}
		{% set has_outgoing = institution.field_mobility_outgoing_students is not empty %}

		{% if has_incoming or has_outgoing %}
			<h2 class="section-title text-center">{{ 'Mobility'|t }}</h2>

			{# Nav tabs #}
			{% if has_incoming and has_outgoing %}
				<ul class="nav nav-tabs justify-content-center" id="mobilityTabs-{{ institution.id() }}" role="tablist">
					<li class="nav-item" role="presentation">
						<button class="nav-link active" id="tab-incoming-{{ institution.id() }}" data-bs-toggle="tab" data-bs-target="#pane-incoming-{{ institution.id() }}" type="button" role="tab" aria-controls="pane-incoming-{{ institution.id() }}" aria-selected="true">
							{{ 'Incoming students'|t }}
						</button>
					</li>
					<li class="nav-item" role="presentation">
						<button class="nav-link" id="tab-outgoing-{{ institution.id() }}" data-bs-toggle="tab" data-bs-target="#pane-outgoing-{{ institution.id() }}" type="button" role="tab" aria-controls="pane-outgoing-{{ institution.id() }}" aria-selected="false">
							{{ 'Outgoing students'|t }}
						</button>
					</li>
				</ul>
			{% endif %}

			{# Tab contents #}
			<div class="tab-content pt-3" id="mobilityTabsContent-{{ institution.id() }}">
				{% if has_incoming %}
					<div class="tab-pane fade show active" id="pane-incoming-{{ institution.id() }}" role="tabpanel" aria-labelledby="tab-incoming-{{ institution.id() }}">
						{{ institution.field_mobility_incoming_students.value|raw }}
					</div>
				{% endif %}

				{% if has_outgoing %}
					<div class="tab-pane fade {{ has_incoming ? '' : 'show active' }}" id="pane-outgoing-{{ institution.id() }}" role="tabpanel" aria-labelledby="tab-outgoing-{{ institution.id() }}">
						{{ institution.field_mobility_outgoing_students.value|raw }}
						{% if institution.field_recognition_outgoing is not empty %}
							<h3 class="subsection-title mt-3">{{ 'Recognition process for outgoing students'|t }}</h3>
							<p>{{ institution.field_recognition_outgoing.value|raw }}</p>
						{% endif %}
						<div class="d-flex flex-column gap-2">


							{% if institution.field_recognition_process_phone.value is defined and institution.field_recognition_process_phone.value %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-phone-alt me-2 mt-1"></i>
									<p class="mb-0">
										<a href="tel:{{ institution.field_recognition_process_phone.value }}" class="text-dark text-decoration-none">
											{{ institution.field_recognition_process_phone.value }}
										</a>
									</p>
								</div>
							{% endif %}

							{% if institution.field_recognition_process_email.value is defined and institution.field_recognition_process_email.value %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-envelope me-2 mt-1"></i>
									<p class="mb-0">
										<a href="mailto:{{ institution.field_recognition_process_email.value }}" class="text-dark text-decoration-none">
											{{ institution.field_recognition_process_email.value }}
										</a>
									</p>
								</div>
							{% endif %}


							{% if institution.field_recognition_process_websit.uri is defined and institution.field_recognition_process_websit.uri %}
								<div class="d-flex align-items-start mb-3">
									<i class="fas fa-globe me-2 mt-1"></i>
									<p class="mb-0">
										<a href="{{ institution.field_recognition_process_websit.uri }}" target="_blank">
											{{ institution.field_recognition_process_websit.title ?: institution.field_recognition_process_websit.uri }}
										</a>
									</p>
								</div>
							{% endif %}
						</div>
					</div>
				{% endif %}
			</div>

		{% endif %}
	</div>
</div>


<div class="section-container section-bg-grey">
	<div class='my-custom-container-2'>

		<div class="admission-section" id='admission' style="scroll-margin-top: 150px;">


			<h2 class="section-title text-center">{{ 'Admission'|t }}</h2>

			{% set has_full_degree = institution.field_admission_descipt_full is not empty or institution.field_registration_proc_full is not empty or institution.field_arrangements_recognition is not empty %}
			{% set has_exchange = institution.field_admission_descript_exchang is not empty
						or institution.field_registration_proc_exchange is not empty
						or institution.field_requirements_nominations is not empty
						or institution.field_additional_requirements is not empty
						or institution.field_applications_autumn_term is not empty
						or institution.field_applications_spring_term is not empty
						or institution.field_nominations_autumn_term is not empty
						or institution.field_nominations_spring_term is not empty
						or institution.field_decision is not empty
						or institution.field_transcript_of_records is not empty
						or institution.field_application_email is not empty
						or institution.field_application_phone is not empty
						or institution.field_application_web is not empty %}
			{% set has_visiting = institution.field_admission_descript_visitin is not empty or institution.field_registration_proc_visiting is not empty %}

			{% if has_full_degree or has_exchange or has_visiting %}
				<ul class="nav nav-tabs justify-content-center" id="admissionTabs-{{ institution.id() }}" role="tablist">
					{% if has_full_degree %}
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="tab-full-degree-{{ institution.id() }}" data-bs-toggle="tab" data-bs-target="#pane-full-degree-{{ institution.id() }}" type="button" role="tab" aria-controls="pane-full-degree-{{ institution.id() }}" aria-selected="true">
								{{ 'Full-Degree'|t }}
							</button>
						</li>
					{% endif %}
					{% if has_exchange %}
						<li class="nav-item" role="presentation">
							<button class="nav-link {{ has_full_degree ? '' : 'active' }}" id="tab-exchange-{{ institution.id() }}" data-bs-toggle="tab" data-bs-target="#pane-exchange-{{ institution.id() }}" type="button" role="tab" aria-controls="pane-exchange-{{ institution.id() }}" aria-selected="{{ has_full_degree ? 'false' : 'true' }}">
								{{ 'Exchange'|t }}
							</button>
						</li>
					{% endif %}
					{% if has_visiting %}
						<li class="nav-item" role="presentation">
							<button class="nav-link {{ (not has_full_degree and not has_exchange) ? 'active' : '' }}" id="tab-visiting-{{ institution.id() }}" data-bs-toggle="tab" data-bs-target="#pane-visiting-{{ institution.id() }}" type="button" role="tab" aria-controls="pane-visiting-{{ institution.id() }}" aria-selected="{{ (not has_full_degree and not has_exchange) ? 'true' : 'false' }}">
								{{ 'Visiting'|t }}
							</button>
						</li>
					{% endif %}
				</ul>

				<div class="tab-content pt-3" id="admissionTabsContent-{{ institution.id() }}">
					{% if has_full_degree %}
						<div class="tab-pane fade show active" id="pane-full-degree-{{ institution.id() }}" role="tabpanel" aria-labelledby="tab-full-degree-{{ institution.id() }}">
							{% if institution.field_admission_descipt_full is not empty %}
								<h3 class="subsection-title">{{ 'Admission description for full-degree students'|t }}</h3>
								<p>{{ institution.field_admission_descipt_full.value | raw }}</p>
							{% endif %}
							{% if institution.field_registration_proc_full is not empty %}
								<h3 class="subsection-title">{{ 'Registration procedures for full-degree students'|t }}</h3>
								<p>{{ institution.field_registration_proc_full.value | raw }}</p>
							{% endif %}
							{% if institution.field_arrangements_recognition is not empty %}
								<h3 class="subsection-title">{{ 'Arrangements for the recognition of credit and prior learning'|t }}</h3>
								<p>{{ institution.field_arrangements_recognition.value | raw }}</p>
							{% endif %}
						</div>
					{% endif %}

					{% if has_exchange %}
						<div class="tab-pane fade {{ has_full_degree ? '' : 'show active' }}" id="pane-exchange-{{ institution.id() }}" role="tabpanel" aria-labelledby="tab-exchange-{{ institution.id() }}">
							{% if institution.field_admission_descript_exchang is not empty %}
								<h3 class="subsection-title">{{ 'Admission description for exchange students'|t }}</h3>
								<p>{{ institution.field_admission_descript_exchang.value | raw }}</p>
							{% endif %}
							{% if institution.field_registration_proc_exchange is not empty %}
								<h3 class="subsection-title">{{ 'Registration procedures for exchange students'|t }}</h3>
								<p>{{ institution.field_registration_proc_exchange.value | raw }}</p>
							{% endif %}
							{% if institution.field_requirements_nominations is not empty %}
								<h3 class="subsection-title">{{ 'Academic requirements for nominations'|t }}</h3>
								<p>{{ institution.field_requirements_nominations.value | raw }}</p>
							{% endif %}
							{% if institution.field_additional_requirements is not empty %}
								<h3 class="subsection-title">{{ 'Additional requirements'|t }}</h3>
								<p>{{ institution.field_additional_requirements.value | raw }}</p>
							{% endif %}
							{% set ex_app_autumn = institution.field_applications_autumn_term is not empty and institution.field_applications_autumn_term.value is defined ? institution.field_applications_autumn_term.value|trim : '' %}
							{% set ex_app_spring = institution.field_applications_spring_term is not empty and institution.field_applications_spring_term.value is defined ? institution.field_applications_spring_term.value|trim : '' %}
							{% set ex_nom_autumn = institution.field_nominations_autumn_term is not empty and institution.field_nominations_autumn_term.value is defined ? institution.field_nominations_autumn_term.value|trim : '' %}
							{% set ex_nom_spring = institution.field_nominations_spring_term is not empty and institution.field_nominations_spring_term.value is defined ? institution.field_nominations_spring_term.value|trim : '' %}
							{% set ex_decision_weeks = institution.field_decision is not empty and institution.field_decision.value is defined ? institution.field_decision.value|trim : '' %}
							{% set ex_transcript_weeks = institution.field_transcript_of_records is not empty and institution.field_transcript_of_records.value is defined ? institution.field_transcript_of_records.value|trim : '' %}
							{% set app_email = institution.field_application_email is not empty and institution.field_application_email.value is defined ? institution.field_application_email.value|trim : '' %}
							{% set app_phone = institution.field_application_phone is not empty and institution.field_application_phone.value is defined ? institution.field_application_phone.value|trim : '' %}
							{% set app_web = '' %}
							{% set app_web_label = '' %}
							{% if institution.field_application_web is not empty %}
								{% set app_web = institution.field_application_web.uri is defined and institution.field_application_web.uri ? institution.field_application_web.uri : (institution.field_application_web.value is defined ? institution.field_application_web.value : '') %}
