let currentCampus = '';
let currentType = '';
const defaultCampusLabel = '{{ 'Campus'|t|e('js') }}';
const defaultTypeLabel = '{{ 'Type'|t|e('js') }}';

const campusButton = document.getElementById('campus-filter-button');
const typeButton = document.getElementById('type-filter-button');
const searchInput = document.getElementById('ou-search');

/** Helper: update button label and color based on active state */
function setButton(buttonEl, hasValue, selectedLabel, defaultLabel) {
const active = !! hasValue;
buttonEl.textContent = active ? (selectedLabel || '').trim() : defaultLabel;

// Aplicar color dinámico si está activo
if (active) {
buttonEl.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--university_primary_color');
buttonEl.style.color = '#fff';
buttonEl.style.borderColor = getComputedStyle(document.documentElement).getPropertyValue('--university_primary_color');
} else {
buttonEl.style.backgroundColor = '';
buttonEl.style.color = '';
buttonEl.style.borderColor = '';
}
}

/** Apply combined filters (text + type + campus) */
function filterOUList() {
const query = (searchInput ?. value || '').toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';
const campus = item.dataset.ouCampusId || '';

const matchText = ! query || title.includes(query) || type.includes(query);
const matchType = ! currentType || type === currentType.toLowerCase();
const matchCampus = ! currentCampus || campus === currentCampus;

item.style.display = (matchText && matchType && matchCampus) ? '' : 'none';
});
}

/* ----- Dropdown handlers (Campus / Type) ----- */
document.querySelectorAll('#filter-campus .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentCampus = this.dataset.campus || '';
setButton(campusButton, currentCampus, this.textContent, defaultCampusLabel);
filterOUList();
});
});

document.querySelectorAll('#filter-type .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentType = this.dataset.type || '';
setButton(typeButton, currentType, this.textContent, defaultTypeLabel);
filterOUList();
});
});

/* ----- Live search (single listener) ----- */
searchInput.addEventListener('input', filterOUList);

/* ----- Initial visual state for buttons ----- */
setButton(campusButton, '', '', defaultCampusLabel);
setButton(typeButton, '', '', defaultTypeLabel);

/* ==========================================================
   SIMPLE PAGINATION (unchanged)
   ========================================================== */
document.addEventListener('DOMContentLoaded', function () {
const items = document.querySelectorAll('#ou-list .ou-item');
const itemsPerPage = 7;
let currentPage = 1;

function showPage(page) {
const start = (page - 1) * itemsPerPage;
const end = page * itemsPerPage;

items.forEach((item, index) => {
item.style.display = (index >= start && index < end) ? '' : 'none';
});

renderPagination(page);
}

function renderPagination(activePage) {
const totalPages = Math.ceil(items.length / itemsPerPage) || 1;
const pagination = document.getElementById('pagination-controls');
if (! pagination) 
return;



pagination.innerHTML = '';

for (let i = 1; i <= totalPages; i++) {
const li = document.createElement('li');
li.className = 'page-item' + (
i === activePage ? ' active' : ''
);
li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
li.addEventListener('click', function (e) {
e.preventDefault();
currentPage = i;
showPage(currentPage);
});
pagination.appendChild(li);
}
}

if (items.length > 0) {
showPage(currentPage);
}
});</script>
