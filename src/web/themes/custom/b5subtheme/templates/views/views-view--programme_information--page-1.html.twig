														{% else %}
															{% set translated_iec = iec %}
														{% endif %}

														{% set iec_years = [] %}
														{% for iec_year_item in translated_iec.field_iec_year %}
															{% set iec_years = iec_years|merge([iec_year_item.value ~ '']) %}
														{% endfor %}

														{% if (course_id ~ '') in iec_years or '0' in iec_years %}
