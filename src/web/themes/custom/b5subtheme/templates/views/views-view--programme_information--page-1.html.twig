						{% for group in compatible_agreement_groups %}
							<div class="compatible-programmes__group">
									<h4>
										{% if group.university_url %}
											<a href="{{ group.university_url }}" target="_blank" rel="noopener noreferrer">{{ group.university }}</a>
										{% else %}
											{{ group.university }}
										{% endif %}
								</h4>

								<div class="compatible-programmes__table-wrap">
									<table class="compatible-programmes__table table table-sm">
