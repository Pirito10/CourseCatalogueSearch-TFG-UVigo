      </div>

      <div class="mt-3">${description}</div>
	  <br>

      ${webHTML}
      ${emailHTML}
      ${phoneHTML}
      ${addressHTML}
      ${gpsHTML}

      <div class="mt-5 text-center">
        <a class="btn btn-dark see-more-ou-button" href="${url}">{{ translations[current_language]['See more'] }}</a>
      </div>
	 
    </div>
  `;

document.getElementById('ou-details').innerHTML = html;
}</script><script>document.getElementById('ou-search').addEventListener('input', function () {
const query = this.value.toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';
item.style.display = (title.includes(query) || type.includes(query)) ? '' : 'none';
});
});</script>
