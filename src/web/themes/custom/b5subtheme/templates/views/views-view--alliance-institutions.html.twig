{% set primary_color = main_page_primary_color|default('#ff4949') %}
{% set alliance_file = alliance.field_alliance_logo.entity ?? null %}
{% set alliance_description = alliance.field_alliance_description.processed|default(alliance.field_alliance_description.value|default('')) %}

{% if alliance %}
  <section class="alliance-institutions-hero section-container">
    <div class="my-custom-container-2">
      <div class="alliance-institutions-hero__inner">
        <div class="alliance-institutions-hero__logo">
          {% if alliance_file %}
            <img src="{{ file_url(alliance_file.getFileUri()) }}" alt="{{ alliance_title }}">
          {% endif %}
        </div>

        <div class="alliance-institutions-hero__content">
          <h1>{{ alliance_title }}</h1>

          {% if alliance_description %}
            <div class="alliance-institutions-hero__description">
              {{ alliance_description|raw }}
            </div>
          {% endif %}

          {% if alliance_email or alliance_phone or alliance_webpage_url %}
            <div class="alliance-institutions-hero__contacts">
              {% if alliance_email %}
                <a href="mailto:{{ alliance_email }}">
                  <i class="fas fa-envelope" aria-hidden="true"></i>
                  <span>{{ alliance_email }}</span>
                </a>
              {% endif %}

              {% if alliance_phone %}
                <a href="tel:{{ alliance_phone|replace({' ': '', '-': '', '(': '', ')': ''}) }}">
                  <i class="fas fa-phone" aria-hidden="true"></i>
                  <span>{{ alliance_phone }}</span>
                </a>
              {% endif %}

              {% if alliance_webpage_url %}
                <a href="{{ alliance_webpage_url }}" target="_blank" rel="noopener noreferrer">
                  <i class="fas fa-globe" aria-hidden="true"></i>
                  <span>{{ alliance_webpage_title|default('Website'|t) }}</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

<section class="main-page-university-grid section-container">
  <div class="my-custom-container-2">
    {% if title and not alliance %}
      <h1 class="main-page-university-grid__title">{{ title }}</h1>
    {% endif %}

    {% if view.result %}
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 g-xl-5">
        {% for row in view.result %}
          {% set institution = row._entity %}
          {% set file = institution.field_institution_card_image.entity %}
          {% set institution_url = row.custom_url ? '/' ~ row.custom_url|trim('/') : null %}
          {% set information = institution.field_information.processed|default(institution.field_information.value|default('')) %}

          <div class="col">
            {% if institution_url %}
              <a href="{{ institution_url }}" class="main-page-university-card">
            {% else %}
              <article class="main-page-university-card">
            {% endif %}

              <div class="main-page-university-card__media">
                {% if file %}
                  <img src="{{ file_url(file.getFileUri()) }}" alt="{{ institution.title.value }}">
                {% endif %}
              </div>

              <div class="main-page-university-card__body">
                <h2 class="main-page-university-card__name">{{ institution.title.value }}</h2>

                {% if row._country_name %}
                  <p class="main-page-university-card__country" style="--card-primary-color: {{ primary_color }};">
                    {{ row._country_name }}
                  </p>
                {% endif %}

                {% if information %}
                  <p class="main-page-university-card__description">
                    {{ information|striptags }}
                  </p>
                {% endif %}
              </div>

            {% if institution_url %}
              </a>
            {% else %}
              </article>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="main-page-university-grid__empty">{{ 'No universities found.'|t }}</p>
    {% endif %}
  </div>
</section>
