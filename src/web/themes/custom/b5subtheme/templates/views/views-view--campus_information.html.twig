// =======================
// DETALLES (misma lógica) + estilos como en el JS base
// =======================
function loadOUDetails(el) {
document.querySelectorAll('.ou-item').forEach(item => item.classList.remove('selected'));
el.classList.add('selected');

const title = el.dataset.ouTitle || '';
const type = el.dataset.ouType || '';
const description = el.dataset.ouDescription || '';
const address = el.dataset.ouAddress || '';
const gps = el.dataset.ouGps || '';
const web = el.dataset.ouWeb || '';
const webLabel = el.dataset.ouWebLabel || web;
const email = el.dataset.ouEmail || '';
const phone = el.dataset.ouPhone || '';
const campus = el.dataset.ouCampusLabel || '';
const url = el.dataset.ouUrl || '#';
const image = el.dataset.ouImage || '';

const imageSrc = image ? image : '/themes/custom/b5subtheme/images/ou-default.png';

// ✅ Bloques opcionales: si el valor está vacío, no se renderiza nada (ni icono ni espacio).
const webHTML = web ? `
      <div class="d-flex align-items-start mb-2">
        <i class="fas fa-globe me-2 mt-1"></i>
        <p class="mb-0"><a href="${web}" target="_blank" rel="noopener">${webLabel}</a></p>
      </div>
  ` : '';

const emailHTML = email ? `
      <div class="d-flex align-items-start mb-2">
        <i class="fas fa-envelope me-2 mt-1"></i>
        <p class="mb-0">${email}</p>
      </div>
  ` : '';

const phoneHTML = phone ? `
	  <div class="d-flex align-items-start mb-2">
        <i class="fas fa-phone me-2 mt-1"></i>
        <p class="mb-0">${phone}</p>
      </div>
  ` : '';

const addressHTML = address ? `
	    <div class="d-flex align-items-start mt-3 mb-2">
        <i class="fas fa-map-marker-alt me-2 mt-1"></i>
        <p class="mb-0">${address}</p>
      </div>
  ` : '';

const gpsHTML = gps ? `
	   <div class="d-flex align-items-start mb-2">
        <i class="fas fa-location-arrow me-2 mt-1"></i>
        <p class="mb-0">${gps}</p>
      </div>
  ` : '';

const html = `
    <div class="mb-3 text-center">
      <img src="${imageSrc}" alt="Organizational Unit" class="img-fluid w-100" style="max-height: 600px; object-fit: cover;" loading="lazy">
    </div>

    <div class="p-4">
      <h4 class="fw-bold">${title}</h4>

      <div class="ou-tag-bar text-white mb-3">
        <span class="ou-type">${
(type || '').toUpperCase()
}</span>
        <!--<span class="ou-campus">${campus}</span>-->
      </div>

      <div class="mt-3">${description}</div>
	  <br>

      ${webHTML}
      ${emailHTML}
      ${phoneHTML}
      ${addressHTML}
      ${gpsHTML}

      <div class="mt-5 text-center">
        <a class="btn btn-dark see-more-ou-button" href="${url}">{{ translations[current_language]['See more'] }}</a>
      </div>
	 
    </div>
  `;

const desktopDetails = document.getElementById('ou-details');
const existingMobileDetails = document.querySelector('.ou-details-mobile');
const isMobile = window.matchMedia('(max-width: 991.98px)').matches;

if (isMobile) {
if (desktopDetails) {
desktopDetails.innerHTML = '';
}

const mobileDetails = existingMobileDetails || document.createElement('div');
mobileDetails.className = 'ou-details-mobile bg-light mb-3';
mobileDetails.innerHTML = html;
el.insertAdjacentElement('afterend', mobileDetails);
mobileDetails.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
} else {
if (existingMobileDetails) {
existingMobileDetails.remove();
}

if (desktopDetails) {
desktopDetails.innerHTML = html;
}
}
}


// =======================
// FILTROS + BUSCADOR (mismo funcionamiento)
// Añadimos SOLO estética: texto del botón = etiqueta elegida (sin prefijo)
// y color activo con --university_primary_color
// =======================
let currentCampus = '';
let currentType = '';

// Botones (respetamos clases existentes)
// const campusButton = document.getElementById('campus-filter-button');
const typeButton = document.getElementById('type-filter-button');

// Helper para aplicar/quitar color activo sin cambiar clases
function setActiveButtonStyle(btn, active) {
const root = getComputedStyle(document.documentElement);
const uniColor = root.getPropertyValue('--university_primary_color') || '';
if (active) {
btn.style.backgroundColor = uniColor;
btn.style.borderColor = uniColor;
btn.style.color = '#fff';
} else {
btn.style.backgroundColor = '';
btn.style.borderColor = '';
btn.style.color = '';
}
}

// CAMPUS
document.querySelectorAll('#filter-campus .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentCampus = this.dataset.campus || '';
// Texto = solo etiqueta elegida; si vacío, vuelve al label por defecto
campusButton.textContent = currentCampus ? this.textContent.trim() : 'Campus';
// Estilo activo
setActiveButtonStyle(campusButton, !! currentCampus);
filterOUList();
});
});

// 🔍 Buscador en tiempo real (mismo comportamiento)
document.getElementById('ou-search').addEventListener('input', function () {
const query = this.value.toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';
item.style.display = (title.includes(query) || type.includes(query)) ? '' : 'none';
});
});

// TYPE
document.querySelectorAll('#filter-type .dropdown-item').forEach(item => {
item.addEventListener('click', function (e) {
e.preventDefault();
currentType = this.dataset.type || '';
typeButton.textContent = currentType ? this.textContent.trim() : 'Type';
setActiveButtonStyle(typeButton, !! currentType);
filterOUList();
});
});

// Filtro general (combina búsqueda + tipo + campus)
function filterOUList() {
const query = document.getElementById('ou-search').value.toLowerCase();
const items = document.querySelectorAll('#ou-list .ou-item');

items.forEach(item => {
const title = item.dataset.ouTitle ?. toLowerCase() || '';
const type = item.dataset.ouType ?. toLowerCase() || '';
const campus = item.dataset.ouCampusId || '';

const matchText = title.includes(query);
const matchType = ! currentType || type === currentType.toLowerCase();
const matchCampus = ! currentCampus || campus === currentCampus;

item.style.display = (matchText && matchType && matchCampus) ? '' : 'none';
});
}

// Duplicado de listener de búsqueda (lo mantenemos tal cual para no tocar funcionamiento)
document.getElementById('ou-search').addEventListener('input', filterOUList);

// =======================
// PAGINACIÓN (mismo funcionamiento; itemsPerPage=2 como enviaste)
// =======================
document.addEventListener("DOMContentLoaded", function () {
const items = document.querySelectorAll("#ou-list .ou-item");
const itemsPerPage = 7;
let currentPage = 1;

function showPage(page) {
const start = (page - 1) * itemsPerPage;
const end = page * itemsPerPage;

items.forEach((item, index) => {
item.style.display = (index >= start && index < end) ? '' : 'none';
});

renderPagination(page);
}

function renderPagination(activePage) {
const totalPages = Math.ceil(items.length / itemsPerPage);
const pagination = document.getElementById("pagination-controls");
pagination.innerHTML = '';

for (let i = 1; i <= totalPages; i++) {
const li = document.createElement("li");
li.className = "page-item" + (
i === activePage ? " active" : ""
);
li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
li.addEventListener("click", function (e) {
e.preventDefault();
currentPage = i;
showPage(currentPage);
});
pagination.appendChild(li);
}
}

if (items.length > 0) {
showPage(currentPage);
}

// Estado inicial de botones (sin color activo)
setActiveButtonStyle(campusButton, false);
setActiveButtonStyle(typeButton, false);
setActiveButtonStyle(areaButton, false);
});</script><!-- ===================== --><!-- JS PROGRAMMES (estilos solo; misma lógica) --><!-- ===================== --><script>
(function () {
const $ = (sel, ctx = document) => ctx.querySelector(sel);
const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));

const input = $('#programmeSearch');
const btn = $('#programmeSearchBtn');
const menuArea = $('#filter-programme-area');
const btnArea = $('#programme-area-filter-button');
const menuLevel = $('#filter-level');
const btnLevel = $('#level-filter-button');
const btnAZ = document.querySelector('.btn.btn-danger.btn-sm');

const norm = s => (s || '').toString().trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const slug = s => norm(s).replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');

const state = {
q: '',
area: '',
level: '',
az: false
};

const groups = [];
document.querySelectorAll('h5.text-uppercase.fw-bold.mt-5.mb-3').forEach(h5 => {
const row = h5.nextElementSibling;
if (row && row.classList.contains('row')) 
groups.push({h5, row});


});

function cardMatches(card) {
const name = norm(card.dataset.name);
const area = slug(card.dataset.programmeArea || '');
const level = slug(card.dataset.level || '');

const okQ = ! state.q || name.includes(state.q) || slug(card.dataset.programmeArea || '').includes(state.q) || slug(card.dataset.level || '').includes(state.q);

const okArea = ! state.area || area === state.area;
const okLevel = ! state.level || level === state.level;
return okQ && okArea && okLevel;
}

function applyFilter() {
const cards = $$('.programme-card');
cards.forEach(card => {
const show = cardMatches(card);
card.closest('.col').style.display = show ? '' : 'none';
});
groups.forEach(({h5, row}) => {
const visible = row.querySelectorAll(':scope > .col:not([style*="display: none"])').length > 0;
h5.style.display = visible ? '' : 'none';
row.style.display = visible ? '' : 'none';
});
if (state.az) 
sortAZ();


}

function sortAZ() {
groups.forEach(({row}) => {
const visibles = $$('.col', row).filter(c => c.style.display !== 'none');
visibles.sort((a, b) => {
const na = norm(a.querySelector('.programme-card').dataset.name);
const nb = norm(b.querySelector('.programme-card').dataset.name);
return na.localeCompare(nb);
});
visibles.forEach(col => row.appendChild(col));
});
}

// ===== Estética de botones de filtro (sin tocar clases / lógica) =====
function setActiveBtnStyle(btn, active) {
const uniColor = getComputedStyle(document.documentElement).getPropertyValue('--university_primary_color') || '';
if (! btn) 
return;


if (active) {
btn.textContent = btn.textContent.trim(); // ya se actualiza más abajo con el label elegido
btn.style.backgroundColor = uniColor;
btn.style.borderColor = uniColor;
btn.style.color = '#fff';
} else {
btn.style.backgroundColor = '';
btn.style.borderColor = '';
btn.style.color = '';
}
}

let t;
if (input) {
input.addEventListener('input', () => {
clearTimeout(t);
t = setTimeout(() => {
state.q = norm(input.value);
applyFilter();
}, 120);
});
}
if (btn) {
btn.addEventListener('click', e => {
e.preventDefault();
state.q = norm(input ? input.value : '');
applyFilter();
});
}

if (menuArea && btnArea) {
menuArea.addEventListener('click', e => {
const a = e.target.closest('a[data-programme-area]');
if (! a) 
return;


e.preventDefault();
state.area = a.dataset.programmeArea ? slug(a.dataset.programmeArea) : '';
// Solo el nombre de la opción
btnArea.textContent = state.area ? a.textContent.trim() : 'Knowledge Area';
setActiveBtnStyle(btnArea, !! state.area);
applyFilter();
});
// estado inicial
setActiveBtnStyle(btnArea, false);
}

if (menuLevel && btnLevel) {
menuLevel.addEventListener('click', e => {
const a = e.target.closest('a[data-type]');
if (! a) 
return;


e.preventDefault();
state.level = a.dataset.type ? slug(a.dataset.type) : '';
// Solo el nombre de la opción
btnLevel.textContent = state.level ? a.textContent.trim() : 'Level';
setActiveBtnStyle(btnLevel, !! state.level);
applyFilter();
});
// estado inicial
setActiveBtnStyle(btnLevel, false);
}

// Botón A-Z: dejamos su comportamiento/clases tal cual (rojo)
if (btnAZ) {
btnAZ.addEventListener('click', e => {
e.preventDefault();
state.az = ! state.az;
btnAZ.classList.toggle('btn-outline-danger', state.az);
btnAZ.classList.toggle('btn-danger', ! state.az);
if (state.az) 
sortAZ();


});
}
})();</script><script>
// Mantener scroll en acordeón (sin cambios de lógica)
(function () {
const keepScroll = () => {
const y = window.scrollY;
window.requestAnimationFrame(() => window.scrollTo(0, y));
};

document.querySelectorAll('.accordion .collapse').forEach(el => {
el.addEventListener('shown.bs.collapse', keepScroll);
el.addEventListener('hidden.bs.collapse', keepScroll);
});

document.querySelectorAll('.accordion [data-bs-toggle="collapse"]').forEach(tr => {
if (tr.tagName === 'A') {
tr.addEventListener('click', e => e.preventDefault());
}
});
})();</script>
