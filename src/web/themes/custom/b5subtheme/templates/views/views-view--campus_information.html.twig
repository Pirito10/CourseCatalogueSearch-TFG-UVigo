{% set institution = view.result[0]._relationship_entities['field_campus_institution'] %}
{#{dump(campus)}#}
{% set current_language = view.result[0].node_field_data_langcode %}

{% if campus.hasTranslation(current_language) %}
	{% set campus = campus.getTranslation(current_language) %}

{% endif %}


{% set university_primary_color = institution.field_primary_color[0].color %}
{% set university_text_color = institution.field_text_color[0].color %}
{% set university_emphasis_text_color = institution.field_emphasis_text_color[0].color %}

{% if institution.hasTranslation(current_language) %}
	{% set institution = institution.getTranslation(current_language) %}

{% endif %}


<style>:root
{
	--university_primary_color: {{university_primary_color}}
	;
	--university_text_color: {{university_text_color}}
	;
	--university_emphasis_text_color: {{university_emphasis_text_color}}
	;
}</style><div class="rs-header ">
<div class="my-custom-container-2">
	<div class="page-band">
		<h1 class="rs-title">CAMPUSES</h1>
	</div>
</div></div><div class="section-container">
<div class="my-custom-container-2">

	<h1 class="section-title mb-3">{{ campus.title.value }}</h1>


	<div class="d-flex mb-3">
		{% if institution.title.value is defined %}
			<span class="ou-tag px-3 py-1" style="background-color: {{ university_primary_color }}; color: #fff; border-radius: 0;">
				{{ institution.title.value }}
			</span>
		{% endif %}

		{% if institution_country_name %}
			<span class="ou-tag px-3 py-1" style="background-color: #fff; color: {{ university_primary_color }}; border: 2px solid {{ university_primary_color }}; border-radius: 0;">
				{{ institution_country_name }}
			</span>
		{% endif %}
	</div>


	<div class="row">
		<div class="col-lg-6">


			{{campus.field_campus_description.value | raw}}


			{% if view.result[0]._relationship_entities['reverse__node__field_aa_campus'] %}
				{% set list_academic_authorities = [] %}

				{#{dump(view.result)}}{{dump(campus.field_campus_description.value)}#}
				<h3 class="subsection-title">{{ 'Academic Contacts'|t }}</h3>
				<br>

				<div class="vstack gap-3 mb-5">
					{% for row in view.result %}


						{% set authority = row._relationship_entities['reverse__node__field_aa_campus'] %}
						{% if  authority.id not in list_academic_authorities %}
							{% set list_academic_authorities = list_academic_authorities|merge([authority.id]) %}

							{% if authority %}
								{% if authority.hasTranslation(current_language) %}
									{% set authority = authority.getTranslation(current_language) %}
								{% endif %}

								

								{% set media = authority.field_ac_photo.entity ?? null %}
								{% set image = media ? media.uri.value : null %}
								{% set role = authority.field_campus_role.value ?? '' %}
								{% set name = authority.title.value %}

								<div class="d-flex align-items-center gap-3">
									{% if image %}
										<img src="{{ file_url(image) }}" alt="{{ name }}" class="rounded-circle" style="width:64px; height:64px; object-fit:cover;">
									{% else %}
										<img src="/themes/custom/b5subtheme/images/default-profile.jpg" alt="{{ name }}" class="rounded-circle" style="width:64px; height:64px; object-fit:cover;">
									{% endif %}

										<div>
											<div class="fw-semibold">{{ name }}</div>
											{% if role %}
												<div class="text-muted text-uppercase small">{{ role }}</div>
											{% endif %}
											{% set aa_web = authority.field_aa_web is not empty and authority.field_aa_web.uri is defined ? authority.field_aa_web.uri : '' %}
											{% set aa_email = authority.field_aa_email is not empty and authority.field_aa_email.value is defined ? authority.field_aa_email.value : '' %}
											{% set aa_phone = authority.field_aa_phone is not empty and authority.field_aa_phone.value is defined ? authority.field_aa_phone.value : '' %}
												<div class="authority-icons d-flex align-items-center gap-3 mt-2">
													{% if aa_web %}
														<a href="{{ aa_web }}"
														   class="authority-icon"
														   target="_blank"
														   rel="noopener noreferrer"
														   data-bs-toggle="tooltip"
														   data-bs-placement="top"
														   title="{{ aa_web }}">
															<i class="fas fa-globe"></i>
														</a>
													{% endif %}
													{% if aa_email %}
														<a href="mailto:{{ aa_email }}"
														   class="authority-icon"
														   data-bs-toggle="tooltip"
														   data-bs-placement="top"
														   title="{{ aa_email }}">
															<i class="fas fa-envelope"></i>
														</a>
													{% endif %}
													{% if aa_phone %}
														<a href="tel:{{ aa_phone }}"
														   class="authority-icon"
														   data-bs-toggle="tooltip"
														   data-bs-placement="top"
														   title="{{ aa_phone }}">
															<i class="fas fa-phone-alt"></i>
														</a>
													{% endif %}

											{% if authority.field_mobility_contact.value %}
												<span class="text-muted small ms-2">
												&middot; {{ 'Mobility'|t }}
												</span>
											{% endif %}

										</div>


									</div>

									

									
								</div>
								

							{% endif %}

						{% endif %}
					{% endfor %}
				</div>
			{% endif %}
		</div>

		<div
			class="col-lg-6">
			{# 1) Imagen del campus (con fallback) #}
			<div class="mb-0 text-center">
				{% set campus_image_url = '/themes/custom/b5subtheme/images/ou-default.png' %}

				{% set campus_base = campus %}
				{% set campus_tr = campus_base %}
				{% if current_language is defined and campus_base.hasTranslation(current_language) %}
					{% set campus_tr = campus_base.getTranslation(current_language) %}
				{% endif %}

				{% if campus_tr.hasField('field_campus_picture') and (not campus_tr.get('field_campus_picture').isEmpty()) %}
					{% set file = campus_tr.get('field_campus_picture').entity %}
					{% if file %}
						{% set campus_image_url = file_url(file.uri.value) %}
						{# o estilo de imagen: {% set campus_image_url = image_style('ou_detail', file.uri.value) %} #}
					{% endif %}
				{% elseif campus_base.hasField('field_campus_picture') and (not campus_base.get('field_campus_picture').isEmpty()) %}
					{% set file = campus_base.get('field_campus_picture').entity %}
					{% if file %}
						{% set campus_image_url = file_url(file.uri.value) %}
					{% endif %}
				{% endif %}

				<img src="{{ campus_image_url }}" alt="{{ campus_tr.label }}" class="img-fluid w-100" style="max-height: 350px; object-fit: cover;">
			</div>

			{# 2) Caja negra con datos (mantengo los mismos campos que tenías) #}
			<div
				class="bg-black text-white pt-4 pb-4 ps-4 pe-4">

				{# Website #}
				{% if campus_tr.hasField('field_campus_web') and campus_tr.field_campus_web.value %}
					<div class="d-flex align-items-start mb-3">
						<i class="fas fa-globe me-2 mt-1"></i>
						<p class="mb-0">
							<a href="{{ campus_tr.field_campus_web.uri ?? campus_tr.field_campus_web.value }}" target="_blank" rel="noopener" style="color: {{university_primary_color}}">
								{{ campus_tr.field_campus_web.title ?? campus_tr.field_campus_web.value }}
							</a>
						</p>
					</div>
				{% endif %}


				{# Email #}
				{% if campus_tr.hasField('field_campus_email') and campus_tr.field_campus_email.value %}
					<div class="d-flex align-items-start mb-3">
						<i class="fas fa-envelope me-2 mt-1"></i>
						<p class="mb-0">
							<a href="mailto:{{ campus_tr.field_campus_email.value }} " style="color: {{university_primary_color}}">
								{{ campus_tr.field_campus_email.value }}
							</a>
						</p>
					</div>
				{% endif %}


				{# Phone #}
				{% if campus_tr.hasField('field_campus_phone') and campus_tr.field_campus_phone.value %}
					<div class="d-flex align-items-start mb-3">
						<i class="fas fa-phone me-2 mt-1"></i>
						<p class="mb-0">{{ campus_tr.field_campus_phone.value }}</p>
					</div>
				{% endif %}

				{# Address #}
				{% if campus_tr.hasField('field_campus_address') and campus_tr.field_campus_address.value %}
					<div class="d-flex align-items-start mb-3">
						<i class="fas fa-map-marker-alt me-2 mt-1"></i>
						<p class="mb-0">{{ campus_tr.field_campus_address.value }}</p>
					</div>
				{% endif %}

				{% set coords = [] %}
				{% if campus_tr.hasField('field_map') and campus_tr.field_map.value %}
					{% set point = campus_tr.field_map.value %}
					{% if point %}
						{% set coords = point|replace({'POINT(':'','POINT (':'', ')':''})|trim|split(' ') %}
					{% endif %}
				{% endif %}
				{% if coords is not empty %}
					<div class="d-flex align-items-start mb-3">
						<i class="fas fa-map-marker-alt me-2 mt-1"></i>
						<p class="mb-0">{{ coords[1]|default('') }},
							{{ coords[0]|default('') }}</p>
					</div>
				{% endif %}
			</div>

			{# 3) Mapa debajo (mismo que tenías, solo reubicado) #}
			<div class="map-wrapper" style="">
				{{ drupal_view('map_view', 'block_3', campus.id) }}
			</div>
		</div>


	</div>
</div></div><!--<img src="/themes/custom/b5subtheme/images/general_information_campuses_map.png" alt="Mapa de campus" class="img-fluid h-100 w-100 object-fit-cover rounded shadow">--><div class='section-container section-bg-grey'>

{% if area_meta|length > 0 %}
	<div class='my-custom-container-2'>
		<h2 class="section-title text-center">{{ translations[current_language]['Programmes'] }}</h3>
			
		<div class="accordion" id="accordionPanelsStayOpenExample">
			{% for area_key, meta in area_meta %}
			
				{% set B = programmes_by_area[area_key]['B']|default([]) %}
				{% set M = programmes_by_area[area_key]['M']|default([]) %}
				{% set D = programmes_by_area[area_key]['PhD']|default([]) %}

				{# 1) Lista única ordenada: primero B, luego M, luego PhD #}
				{% set ordered = B|merge(M)|merge(D) %}
				{% set total = ordered|length %}

				{# Si solo hay un área, expandirla #}
				{% set expanded = (area_meta|length == 1) %}

				{% if total > 0 %}
					{% set cid = 'acc-' ~ loop.index ~ '-' ~ area_key|replace({' ':'-'}) %}

					<div class="accordion-item mb-2">
						<h2 class="accordion-header" id="{{ cid }}-head">
							<button class="accordion-button {{ expanded ? '' : 'collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ cid }}-body" aria-expanded="false" aria-controls="{{ cid }}-body">
								{% if meta.icon is defined and meta.icon %}
									<i class="{{ meta.icon }}"></i>
								{% endif %}
								<span class="fw-semibold">{{ meta.label|default(area_key)|upper }}</span>
								<span class="ms-auto small fw-bold">
									B
									{{ B|length }}
									· M
									{{ M|length }}
									· PhD
									{{ D|length }}
								</span>
							</button>
						</h2>

						<div id="{{ cid }}-body" class="accordion-collapse collapse {{ expanded ? 'show' : '' }}" aria-labelledby="{{ cid }}-head">
							<div
								class="accordion-body">

								{# 2) Columnas automáticas (2 si <=18; 3 si >18) #}
								{% set cols = total > 18 ? 3 : 2 %}
								{% set per_col = (total / cols)|round(0, 'ceil') %}

								<div class="row g-4">
									{% for c in 0..(cols-1) %}
										{% set slice = ordered|slice(c*per_col, per_col) %}
										{% if slice|length %}
											<div class="col-md-{{ 12 // cols }}">
												<ul class="list-unstyled mb-0">
													{% for p in slice %}
														{# 3) Prefijo por nivel (B / M / PhD) #}
														{#{dump(p)}#}
														{% set lvl_raw = p.level_code|default(p.level|default('')) %}
														{#{dump(lvl_raw)}#}
														{% set lvl = lvl_raw|lower %}
												

															{% if lvl starts with '6' %}
															{% set prefix = 'B' %}
														{% elseif lvl starts with '7' %}
															{% set prefix = 'M' %}
														{% elseif lvl starts with '8' %}
															{% set prefix = 'PhD' %}
														{% endif %}

														<li class="mb-2">
															{% if prefix == 'B' %}
																<span class="fw-bold me-1 text-dark">{{ prefix }}</span>
															{% else %}
																<span class="fw-bold me-1" style="color: var(--university_primary_color)">{{ prefix }}</span>
															{% endif %}&middot;

															<a href="{{ p.programme_url }}" class="text-reset text-decoration-none ms-1">{{ p.label }}</a>

															{% if p.interuniversity is defined and p.interuniversity %}
																<em class="text-danger ms-2">Interuniversity</em>
															{% endif %}

															{% if p.ects is defined and p.ects %}
																<span class="text-muted ms-2">{{ p.ects }}
																	ECTS</span>
															{% endif %}
														</li>
													{% endfor %}
												</ul>
											</div>
										{% endif %}
									{% endfor %}
								</div>

							</div>
						</div>
					</div>
				{% endif %}
			{% endfor %}
		</div>
	{% endif %}
