					<div class="row institution-new-catalogue-results">
						
						
						<div class="col-lg-2 institution-new-catalogue-sort">
							<h3 class="subsection-title p-0 pb-2 m-0">
								<i class="fas fa-sort-amount-down me-2"></i>
								{{ 'Sort'|t|upper }}
							</h3>

							<div class="group-search-sort-buttons w-100">
								<button class="btn btn-dark btn-sm btn-whithout-border-radius js-sort" data-sort-by="title" data-sort-order="ASC">A - Z</button>

								<button class="btn btn-dark btn-sm btn-whithout-border-radius m-0 js-sort" data-sort-by="field_isced_f" data-sort-order="ASC">{{ 'Field of Study'|t }}</button>

								<button class="btn btn-dark btn-sm btn-whithout-border-radius m-0 js-sort" data-sort-by="field_eqf_level" data-sort-order="ASC">{{ 'Level'|t }}</button>

								<button class="btn btn-dark btn-sm btn-whithout-border-radius m-0 js-sort" data-sort-by="field_credits" data-sort-order="ASC">ECTS</button>
							</div>

						</div>

						

						<div
							class="col-lg-10 ps-lg-5 institution-new-catalogue-list" id="programme-list">
							{# Puedes seguir con tu loop propio: AJAX reemplaza todo el wrapper #}
							{% if view.result is not empty %}
								{% for row in view.result %}
								

										{% set programme = row._entity %}
										{% set institution = row.display_institution|default(programme.field_programme_institution.entity ?? null) %}
										{% set ou = row.display_ou|default(programme.field_programme_ou.entity ?? null) %}

										{% set logo_uri = null %}
									{% if ou and ou.field_ou_picture.entity is defined %}
										{% set logo_uri = ou.field_ou_picture.entity.fileuri %}
									{% endif %}
									<div class="programme-item">
									
										<a href="{{ row.custom_url }}" class="text-decoration-none text-reset" target="_blank">
											<div class="card shadow-none mb-3 border-0 rounded-0 position-relative catalogue-programme-card" style="height: 100.65px; cursor: pointer;">
