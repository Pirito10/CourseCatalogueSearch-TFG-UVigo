function admin_area_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();

  $bundles = [
    'institution',
    'campus',
    'organizational_unit',
    'resources_and_services',
    'programme',
    'individual_educational_component',
    'academic_authority',
    'iec_instance',
  ];

  if (in_array($node->bundle(), $bundles, TRUE)) {
    if (isset($form['uid'])) {
      $form['uid']['#access'] = TRUE;
    }
  }
}



































use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;


/**
 * Implements hook_views_query_alter().
 */
function admin_area_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'admin_available_joint_programmes') {
    return;
  }


  $institution_nid = admin_area_get_current_user_group_institution_nid();

  if (empty($institution_nid)) {
    return;
  }

  $query->addWhereExpression(0, "
    node_field_data.nid NOT IN (
      SELECT jp_programme.entity_id
      FROM {node__field_programme} jp_programme
      INNER JOIN {node__field_programme_institution} programme_inst
        ON programme_inst.entity_id = jp_programme.field_programme_target_id
      WHERE programme_inst.field_programme_institution_target_id = :current_institution_own
        AND jp_programme.deleted = 0
        AND programme_inst.deleted = 0
    )
  ", [
    ':current_institution_own' => $institution_nid,
  ]);


  $query->addWhereExpression(0, "
    node_field_data.nid NOT IN (
      SELECT member_jp.field_member_joint_programme_target_id
      FROM {node__field_member_joint_programme} member_jp
      INNER JOIN {node__field_member_institution} member_inst
        ON member_inst.entity_id = member_jp.entity_id
      WHERE member_inst.field_member_institution_target_id = :current_institution_membership
        AND member_jp.deleted = 0
        AND member_inst.deleted = 0
    )
  ", [
    ':current_institution_membership' => $institution_nid,
  ]);
}

















/**
 * Obtiene el grupo del usuario actual.
 */
function admin_area_get_current_user_group_id() {
  $account = \Drupal::currentUser();

  if ($account->isAnonymous()) {
    return NULL;
  }

  $user = User::load($account->id());

  if (!$user) {
    return NULL;
  }

  /** @var \Drupal\group\Entity\GroupMembershipLoaderInterface $membership_loader */
  $membership_loader = \Drupal::service('group.membership_loader');
  $memberships = $membership_loader->loadByUser($user);

  foreach ($memberships as $membership) {
    $group = $membership->getGroup();

    if ($group) {
      return (int) $group->id();
    }
  }

  return NULL;
}


function admin_area_get_current_user_group_institution_nid() {
  $gid = admin_area_get_current_user_group_id();

  if (!$gid) {
    return NULL;
  }

  $institution_nid = \Drupal::database()
    ->select('group_relationship_field_data', 'grfd')
    ->fields('grfd', ['entity_id'])
    ->condition('grfd.gid', $gid)
    ->condition('grfd.plugin_id', 'group_node:institution')
    ->range(0, 1)
    ->execute()
    ->fetchField();

  return $institution_nid ? (int) $institution_nid : NULL;
}



function admin_area_form_node_member_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $request = \Drupal::request();

  $joint_programme_nid = $request->query->get('field_member_joint_programme');
  $institution_nid = admin_area_get_current_user_group_institution_nid();

  if ($institution_nid && isset($form['field_member_institution']['widget'][0]['target_id'])) {
    $form['field_member_institution']['widget'][0]['target_id']['#default_value'] = Node::load($institution_nid);
  }

  if ($joint_programme_nid && isset($form['field_member_joint_programme']['widget'][0]['target_id'])) {
    $form['field_member_joint_programme']['widget'][0]['target_id']['#default_value'] = Node::load($joint_programme_nid);
  }

  $form['field_member_institution']['widget'][0]['target_id']['#disabled'] = TRUE;
  $form['field_member_joint_programme']['widget'][0]['target_id']['#disabled'] = TRUE;
}